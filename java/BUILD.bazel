load("@rules_java//java:defs.bzl", "java_binary", "java_library")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
# The engine of record's own Maven set. Kept separate from JENA_DEPS below:
# they are DIFFERENT JENA VERSIONS (5.2.0 vs 5.0.0) and must never meet on one
# classpath. See //docs/rfc-005-one-engine-of-record.md.
# ⛔ NOT `load("@rules_jena//jena:defs.bzl", "JENA_DEPS")`. Those labels live in
# rules_jena's own `@jena_maven`, which Bzlmod does not make visible outside the
# module that declared it — the build fails with "No repository visible as
# '@jena_maven'". The version is restated in `@gate_maven` instead; MODULE.bazel
# says so at the install, and RFC-005 §3 records that the restatement is an
# ungated drift risk.
GATE_JENA_DEPS = [
    "@gate_maven//:org_apache_jena_jena_arq",
    "@gate_maven//:org_apache_jena_jena_core",
    "@gate_maven//:org_apache_jena_jena_base",
    "@gate_maven//:org_apache_jena_jena_iri",
    "@gate_maven//:org_slf4j_slf4j_simple",
]

package(default_visibility = ["//visibility:public"])

JENA_DEPS = [
    "@spec_maven//:org_apache_jena_jena_arq",
    "@spec_maven//:org_apache_jena_jena_core",
    "@spec_maven//:org_apache_jena_jena_base",
    "@spec_maven//:org_apache_jena_jena_iri",
    "@spec_maven//:org_slf4j_slf4j_simple",
]

# Shared corpus loader — loads the framework rfc: vocabulary (bundled as a
# classpath resource, /ontology/aion-rfc.ttl) plus the consumer's domain
# TBox + corpus (from a kg-root path) into one in-memory Jena Dataset.
java_library(
    name = "loader",
    srcs = ["kg/Loader.java"],
    resources = ["//rdf/ontology:aion-rfc.ttl"],
    resource_strip_prefix = "rdf",
    deps = JENA_DEPS,
)

# Platform-correct cache/config/data dirs (XDG / macOS Library /
# LOCALAPPDATA). Used by the LLM cache layer.
java_library(
    name = "aion_paths",
    srcs = ["kg/AionPaths.java"],
    deps = ["@spec_maven//:dev_dirs_directories"],
)

# Deterministic Turtle serializer (byte-stable round-trip).
java_library(
    name = "writer",
    srcs = ["kg/Writer.java"],
    deps = JENA_DEPS,
)

# The graph-content gate runner: runs the SHACL shapes + the 5 framework
# consistency gates against a Dataset. The shapes + consistency queries
# ship bundled as classpath resources (/ontology/shapes.ttl,
# /queries/consistency/*.rq); domain gates (contradictions) + the
# query-smoke walk come from the consumer's kg-root.
java_library(
    name = "gate_harness",
    srcs = [
        "kg/GateHarness.java",
        "kg/Gates.java",
    ],
    resources = [
        "//rdf/ontology:shapes.ttl",
        "//rdf/queries/consistency:dangling-references.rq",
        "//rdf/queries/consistency:circular-deps.rq",
        "//rdf/queries/consistency:diagnostic-collisions.rq",
        "//rdf/queries/consistency:inverse-edges.rq",
        "//rdf/queries/consistency:untyped-documents.rq",
    ],
    resource_strip_prefix = "rdf",
    deps = JENA_DEPS + ["@spec_maven//:org_apache_jena_jena_shacl"],
)

# Mutation primitive: load TTL -> mutate Model -> preflight gates ->
# serialize. The shared core used by kg_edit (Aion) and kg_research
# (mycelium).
java_library(
    name = "write_ops",
    srcs = ["kg/edit/WriteOps.java"],
    deps = JENA_DEPS + [
        ":loader",
        ":writer",
        ":gate_harness",
    ],
)

# LLM adapter SPI + cache + concrete adapters (Anthropic / Ollama /
# Fake). Kept dependency-light so non-LLM consumers don't pull it.
java_library(
    name = "llm",
    srcs = glob(["kg/reasoner/llm/*.java"]),
    deps = JENA_DEPS + [":aion_paths"],
)

# ── Migrated from Aion kg/java: generic spec-stack KG tooling ──────────
# Libraries only; consumers (Aion) keep the *_sync_test / *_pr_gate
# java_binary targets that point these mains at their own corpus + data.

# Semantic lint engine — a catalog of Tier-3 corpus checks (one .rq each).
java_library(
    name = "kg_lint_lib",
    srcs = [
        "kg/lint/KgLint.java",
        "kg/lint/LintCheck.java",
    ],
    deps = JENA_DEPS + [":loader"],
)

# OWL-MICRO + Jena-rule reasoner runner (+ StrContains builtin).
java_library(
    name = "reasoner",
    srcs = [
        "kg/reasoner/KgReasoner.java",
        "kg/reasoner/builtins/StrContains.java",
    ],
    deps = JENA_DEPS + [
        ":loader",
        ":writer",
        ":aion_paths",
        ":llm",
    ],
)

# Corpus coverage/metrics dashboard generator.
java_library(
    name = "metrics",
    srcs = ["kg/metrics/KgMetrics.java"],
    deps = JENA_DEPS + [
        ":loader",
        ":kg_lint_lib",
    ],
)

# Corpus → Lean derivation-stub generator.
java_library(
    name = "corpus_to_lean",
    srcs = ["kg/lean/CorpusToLean.java"],
    deps = JENA_DEPS + [":loader"],
)

# Lean proof post-processor (sorry-patch failing proofs). Standalone.
java_library(
    name = "validate_proofs",
    srcs = ["kg/lean/ValidateProofs.java"],
)

# LLM-gated Lean proof generator.
java_library(
    name = "generate_proofs",
    srcs = ["kg/lean/GenerateProofs.java"],
    deps = JENA_DEPS + [
        ":loader",
        ":llm",
        ":validate_proofs",
    ],
)

# provenBy ↔ theorem bidirectional sync checker.
java_library(
    name = "provenby",
    srcs = ["kg/lean/ProvenBySyncCheck.java"],
    deps = JENA_DEPS + [":loader"],
)

# KG authoring CLI (search / show / scaffold / add-edge / remove-term).
java_library(
    name = "kg_edit_lib",
    srcs = glob([
        "kg/edit/*.java",
        "kg/edit/cmd/*.java",
    ]),
    deps = JENA_DEPS + [
        ":loader",
        ":writer",
        ":gate_harness",
        ":write_ops",
    ],
)

# ── The gate runner ────────────────────────────────────────────────────────────
#
# The first java_binary in this file. The comment above has said since the
# migration that consumers keep the entry points; spec is now a consumer.
#
# ⛔ NOTE THE DEPS. This target links @rules_jena's Jena (5.2.0) and NOT
# @spec_maven's (5.0.0) — deliberately, and it is why it cannot reuse :loader.
# Two Jena versions on one classpath means the answer depends on classpath order,
# and this binary's whole value is being the SAME answer the sparql_query_test
# targets give. `result_emit` is the library JenaSparql itself calls; linking it
# makes agreement structural rather than asserted. RFC-005 §3 has the argument.
java_library(
    name = "gate_lib",
    srcs = ["kg/gate/GateCli.java"],
    visibility = ["//visibility:public"],
    deps = GATE_JENA_DEPS + ["@rules_jena//jena/sparql:result_emit"],
)

java_binary(
    name = "gate_cli",
    main_class = "kg.gate.GateCli",
    visibility = ["//visibility:public"],
    runtime_deps = [":gate_lib"],
)

# The same gates, held warm behind loopback HTTP. See GateServer's header for
# why this hop is not gRPC and why /preflight takes additions only.
java_binary(
    name = "gate_binary",
    srcs = ["kg/gate/GateServer.java"],
    main_class = "kg.gate.GateServer",
    visibility = ["//visibility:public"],
    # ⛔ result_emit is the engine of record's own execution+formatting library
    # (rules_jena >= 0.3.2). Linking it is what makes agreement with the
    # sparql_query_test targets STRUCTURAL rather than asserted. At 0.3.0 this
    # was a `data` dep on the jena_sparql binary and a subprocess per gate.
    deps = GATE_JENA_DEPS + [":gate_lib"],
)

# ── The gate plane as an image ─────────────────────────────────────────────────
#
# Built by Bazel and pushed by CI, so the sidecar RFC-006 §3 wants is producible
# from THIS repo. Before this, nothing here built an image at all — ci.yml has
# two jobs and neither touches a registry, and the `spec:<sha>` tags come from
# the platform build-runner. That made the JVM sidecar blocked on work in another
# repo; it no longer is.
#
# ⛔ The deploy jar, not the runfiles tree. `java_binary` also emits a launcher
# script that expects a runfiles layout and a JAVA_HOME; in a distroless image
# there is no shell to run it. The fat jar has one dependency — a JRE — and the
# base supplies exactly that.
pkg_tar(
    name = "gate_binary_layer",
    srcs = [":gate_binary_deploy.jar"],
    package_dir = "/app",
)

# ⛔ THE CORPUS SHIPS IN THE IMAGE, and this is a correction to the first version
# of this target, which took corpus paths as deployment args.
#
# A gate report is only meaningful against a stated corpus. Mounting the corpus
# at deploy time means the image and the graph it gates version independently,
# so "vacuous_invariant EXAMINED_NOTHING" from one pod and "FAILED" from another
# are both true and there is nothing in either answer to say which corpus it read.
# The corpus is 220 KB of Turtle and is already a build artifact; shipping it here
# makes the image self-describing and `corpus_version` a property of the artifact
# rather than of a volume mount somebody has to get right.
#
# It also makes the image runnable with no arguments, which is what let this get
# tested at all — see gate_image_load.
pkg_tar(
    name = "gate_corpus_layer",
    srcs = [
        "//corpus/studio:corpus.ttl",
        "//corpus/studio:disciplines.ttl",
        "//corpus/studio:proposals.ttl",
        "//corpus/studio:terms.ttl",
        "//rdf/lint/authoring:queries",
        "//rdf/ontology:aion-rfc.ttl",
        "//rdf/ontology:authoring.ttl",
        "//rdf/ontology:tier.ttl",
    ],
    package_dir = "/corpus",
)

oci_image(
    name = "gate_image",
    base = "@java_base",
    # The suite and the corpus it reads, both fixed at build time. A deployment
    # chooses the PORT and nothing else — see the note on gate_corpus_layer.
    cmd = [
        "--gate=envelope_unrecorded=/corpus/envelope-unrecorded.rq",
        "--gate=conflict_hygiene_strict=/corpus/conflict-hygiene-strict.rq",
        "--gate=ladder_integrity=/corpus/ladder-integrity.rq",
        "--gate=vacuous_invariant=/corpus/vacuous-invariant.rq",
        # Over studio this reads EXAMINED_NOTHING — no studio claim is at R4, so
        # none carries a tier — and the suite's `clean` goes false until one
        # does. That is the truthful state the three-valued status exists to
        # expose, and the list here matches _GATES in //rdf:authoring_gates.bzl
        # rather than forking it; derivation.rs admissibility counts only
        # FAILED deltas.
        "--gate=tier_rung_coherence=/corpus/tier-rung-coherence.rq",
        "/corpus/aion-rfc.ttl",
        "/corpus/authoring.ttl",
        "/corpus/tier.ttl",
        "/corpus/corpus.ttl",
        "/corpus/disciplines.ttl",
        "/corpus/terms.ttl",
        "/corpus/proposals.ttl",
    ],
    entrypoint = [
        "java",
        "-jar",
        "/app/gate_binary_deploy.jar",
    ],
    tars = [
        ":gate_binary_layer",
        ":gate_corpus_layer",
    ],
    visibility = ["//visibility:public"],
)

# ⛔ An image that assembles is not an image that runs. This loads it into the
# local daemon so `docker run` can prove the entrypoint resolves, the JRE is
# present, and the jar starts — the three things a green `oci_image` does NOT
# tell you. The plugin image in this repo was once "produced by hand" precisely
# because nobody found out until deploy time.
oci_load(
    name = "gate_image_load",
    image = ":gate_image",
    repo_tags = ["spec-gate:local"],
)

# Pushed by CI. The tag comes from the pipeline, never from here — see the note
# on `image.tag` in deploy/charts/plugin-spec/values.yaml.
oci_push(
    name = "gate_image_push",
    image = ":gate_image",
    repository = "491117466965.dkr.ecr.us-east-1.amazonaws.com/spec-gate",
)
