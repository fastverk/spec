load("@rules_java//java:defs.bzl", "java_library")

package(default_visibility = ["//visibility:public"])

JENA_DEPS = [
    "@spec_maven//:org_apache_jena_jena_arq",
    "@spec_maven//:org_apache_jena_jena_core",
    "@spec_maven//:org_apache_jena_jena_base",
    "@spec_maven//:org_apache_jena_jena_iri",
    "@spec_maven//:org_slf4j_slf4j_simple",
]

# Shared corpus loader — loads the framework rfc: vocabulary (bundled as a
# classpath resource, /ontology/aion-rfc.ttl) plus the consumer's domain
# TBox + corpus (from a kg-root path) into one in-memory Jena Dataset.
java_library(
    name = "loader",
    srcs = ["kg/Loader.java"],
    resources = ["//rdf/ontology:aion-rfc.ttl"],
    resource_strip_prefix = "rdf",
    deps = JENA_DEPS,
)

# Platform-correct cache/config/data dirs (XDG / macOS Library /
# LOCALAPPDATA). Used by the LLM cache layer.
java_library(
    name = "aion_paths",
    srcs = ["kg/AionPaths.java"],
    deps = ["@spec_maven//:dev_dirs_directories"],
)

# Deterministic Turtle serializer (byte-stable round-trip).
java_library(
    name = "writer",
    srcs = ["kg/Writer.java"],
    deps = JENA_DEPS,
)

# The graph-content gate runner: runs the SHACL shapes + the 4 framework
# consistency gates against a Dataset. The shapes + consistency queries
# ship bundled as classpath resources (/ontology/shapes.ttl,
# /queries/consistency/*.rq); domain gates (contradictions) + the
# query-smoke walk come from the consumer's kg-root.
java_library(
    name = "gate_harness",
    srcs = [
        "kg/GateHarness.java",
        "kg/Gates.java",
    ],
    resources = [
        "//rdf/ontology:shapes.ttl",
        "//rdf/queries/consistency:dangling-references.rq",
        "//rdf/queries/consistency:circular-deps.rq",
        "//rdf/queries/consistency:diagnostic-collisions.rq",
        "//rdf/queries/consistency:inverse-edges.rq",
    ],
    resource_strip_prefix = "rdf",
    deps = JENA_DEPS + ["@spec_maven//:org_apache_jena_jena_shacl"],
)

# Mutation primitive: load TTL -> mutate Model -> preflight gates ->
# serialize. The shared core used by kg_edit (Aion) and kg_research
# (mycelium).
java_library(
    name = "write_ops",
    srcs = ["kg/edit/WriteOps.java"],
    deps = JENA_DEPS + [
        ":loader",
        ":writer",
        ":gate_harness",
    ],
)

# LLM adapter SPI + cache + concrete adapters (Anthropic / Ollama /
# Fake). Kept dependency-light so non-LLM consumers don't pull it.
java_library(
    name = "llm",
    srcs = glob(["kg/reasoner/llm/*.java"]),
    deps = JENA_DEPS + [":aion_paths"],
)

# ── Migrated from Aion kg/java: generic spec-stack KG tooling ──────────
# Libraries only; consumers (Aion) keep the *_sync_test / *_pr_gate
# java_binary targets that point these mains at their own corpus + data.

# Semantic lint engine — a catalog of Tier-3 corpus checks (one .rq each).
java_library(
    name = "kg_lint_lib",
    srcs = [
        "kg/lint/KgLint.java",
        "kg/lint/LintCheck.java",
    ],
    deps = JENA_DEPS + [":loader"],
)

# OWL-MICRO + Jena-rule reasoner runner (+ StrContains builtin).
java_library(
    name = "reasoner",
    srcs = [
        "kg/reasoner/KgReasoner.java",
        "kg/reasoner/builtins/StrContains.java",
    ],
    deps = JENA_DEPS + [
        ":loader",
        ":writer",
        ":aion_paths",
        ":llm",
    ],
)

# Corpus coverage/metrics dashboard generator.
java_library(
    name = "metrics",
    srcs = ["kg/metrics/KgMetrics.java"],
    deps = JENA_DEPS + [
        ":loader",
        ":kg_lint_lib",
    ],
)

# Corpus → Lean derivation-stub generator.
java_library(
    name = "corpus_to_lean",
    srcs = ["kg/lean/CorpusToLean.java"],
    deps = JENA_DEPS + [":loader"],
)

# Lean proof post-processor (sorry-patch failing proofs). Standalone.
java_library(
    name = "validate_proofs",
    srcs = ["kg/lean/ValidateProofs.java"],
)

# LLM-gated Lean proof generator.
java_library(
    name = "generate_proofs",
    srcs = ["kg/lean/GenerateProofs.java"],
    deps = JENA_DEPS + [
        ":loader",
        ":llm",
        ":validate_proofs",
    ],
)

# provenBy ↔ theorem bidirectional sync checker.
java_library(
    name = "provenby",
    srcs = ["kg/lean/ProvenBySyncCheck.java"],
    deps = JENA_DEPS + [":loader"],
)

# KG authoring CLI (search / show / scaffold / add-edge / remove-term).
java_library(
    name = "kg_edit_lib",
    srcs = glob([
        "kg/edit/*.java",
        "kg/edit/cmd/*.java",
    ]),
    deps = JENA_DEPS + [
        ":loader",
        ":writer",
        ":gate_harness",
        ":write_ops",
    ],
)
