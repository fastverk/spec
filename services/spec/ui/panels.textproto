# spec plugin — meridian PanelBundle.
#
# The fastverk-web shell fetches this via the gateway (/api/gw/spec/panels.binpb),
# decodes it, and composes it into the "Specs" section. populate.service/.method
# are the proto coordinates the shell routes through /api/gw/spec/* via the
# web_routes in /describe (ListSpecs -> specs, ListContracts -> contracts,
# ListModuleStatus -> status). Field names match spec.proto (snake_case), and the
# backend renders enums as short strings ("GREEN"/"LEAN"), so no column format is
# needed. Compiled to .binpb by the `meridian_panel_bundle` Bazel rule.

# ============================================================
# SPECS — every formal-spec file across the estate, with its
# verifying target + green/sorry status.
# ============================================================
panels {
  panel_id: "specs"
  title: "Specs"
  table {
    populate {
      service: "spec.v1.SpecIndex"
      method: "ListSpecs"
    }
    rows_field: "specs"
    item_noun: "specs"
    placeholder: "No specifications indexed."
    columns {
      header: "Repo"
      field_path: "repo"
      pref_width: 16
    }
    columns {
      header: "Module"
      field_path: "module"
      pref_width: 28
    }
    columns {
      header: "Path"
      field_path: "path"
      pref_width: 34
    }
    columns {
      header: "Lang"
      field_path: "lang"
      pref_width: 8
    }
    columns {
      header: "Kind"
      field_path: "kind"
      pref_width: 12
    }
    columns {
      header: "Status"
      field_path: "status"
      pref_width: 10
    }
    columns {
      header: "Sorries"
      field_path: "sorry_count"
      pref_width: 8
    }
  }
}

# ============================================================
# CONTRACTS — catalog rows (theorem-backed promises) with live
# discharge + citation status. botnoc-only in v1; the repo
# column future-proofs adoption by other repos.
# ============================================================
panels {
  panel_id: "contracts"
  title: "Contracts"
  table {
    populate {
      service: "spec.v1.SpecIndex"
      method: "ListContracts"
    }
    rows_field: "contracts"
    item_noun: "contracts"
    placeholder: "No contract catalog found."
    columns {
      header: "Repo"
      field_path: "repo"
      pref_width: 12
    }
    columns {
      header: "ID"
      field_path: "id"
      pref_width: 6
    }
    columns {
      header: "Theorem"
      field_path: "name"
      pref_width: 30
    }
    columns {
      header: "Promise"
      field_path: "promise"
      pref_width: 48
    }
    columns {
      header: "Discharger"
      field_path: "discharger"
      pref_width: 40
    }
    columns {
      header: "Cited"
      field_path: "cited"
      pref_width: 7
    }
    columns {
      header: "Status"
      field_path: "status"
      pref_width: 10
    }
  }
}

# ============================================================
# PROOF STATUS — per-module rollup (green / sorry) across the
# estate, with the verifying lean_test target.
# ============================================================
panels {
  panel_id: "status"
  title: "Proof Status"
  table {
    populate {
      service: "spec.v1.SpecIndex"
      method: "ListModuleStatus"
    }
    rows_field: "modules"
    item_noun: "modules"
    placeholder: "No modules indexed."
    columns {
      header: "Repo"
      field_path: "repo"
      pref_width: 16
    }
    columns {
      header: "Module"
      field_path: "module"
      pref_width: 30
    }
    columns {
      header: "Target"
      field_path: "target"
      pref_width: 28
    }
    columns {
      header: "Status"
      field_path: "status"
      pref_width: 10
    }
    columns {
      header: "Sorries"
      field_path: "sorry_count"
      pref_width: 8
    }
    columns {
      header: "Specs"
      field_path: "spec_count"
      pref_width: 8
    }
  }
}

# ══════════════════════════════════════════════════════════════════════════════
# THE RFC-002 AUTHORING READ MODEL
#
# Six more `table` panels, populated from spec.v1.Authoring instead of
# spec.v1.SpecIndex. They are in THIS bundle rather than a second one because the
# shell fetches exactly one: botnoc web/static/assets/main.js resolves the bundle
# as `${base}/panels.binpb` (fetchPluginPanels), NOT from manifest.panels[].
# bundle_path — so a second meridian_panel_bundle would never be discovered.
#
# Everything below is DECLARATIVE. plugin-mycelium's panels.textproto states the
# property in its own header: "the shell decodes the bundle, builds a nav leaf per
# panel, and renders each table via renderPanelInto — populating rows from
# populate.service/.method, which the shell routes through the web_routes in
# /describe. No shell-side (main.js) code."
#
# So these six reach the browser with no botnoc change, no ADHOC_HANDLERS entry,
# and no meridian_schemas change. The rows come from
# services/spec/readmodel/*.json, emitted by tools/readmodel/emit_readmodel.py;
# src/readmodel.rs serves them and src/http.rs declares the routes.
#
# The richer surfaces these tables stand in for — the constraint-bar axis with the
# intersection drawn, the faceted lattice with conflict heat — are stage 3 and DO
# need an adhoc handler. See docs/rfc-002a-browser-authoring-path.md.
# ══════════════════════════════════════════════════════════════════════════════

# ============================================================
# CONFLICTS — the board. Sorted server-side by blocked work
# orders: a conflict matters in proportion to how much
# construction it stops.
#
# `state` is derived, not stored — a conflict with no
# au:Resolution is open. RFC-002 §7 deliberately keeps
# UNRESOLVED a measure rather than a gate, so "open" is a
# legitimate steady state and the board must show it without
# implying failure.
# ============================================================
panels {
  panel_id: "conflicts"
  title: "Conflicts"
  table {
    populate {
      service: "spec.v1.Authoring"
      method: "ListConflicts"
    }
    rows_field: "conflicts"
    item_noun: "conflicts"
    placeholder: "No cross-discipline conflicts recorded."
    columns {
      header: "Project"
      field_path: "project"
      pref_width: 10
    }
    columns {
      header: "ID"
      field_path: "id"
      pref_width: 10
    }
    columns {
      header: "Kind"
      field_path: "kind"
      pref_width: 20
    }
    columns {
      header: "Disciplines"
      field_path: "disciplines"
      pref_width: 44
    }
    columns {
      header: "Parties"
      field_path: "party_count"
      pref_width: 8
    }
    columns {
      header: "Blocks"
      field_path: "blocked_orders"
      pref_width: 7
    }
    columns {
      header: "Owner"
      field_path: "owner"
      pref_width: 18
    }
    columns {
      header: "State"
      field_path: "state"
      pref_width: 9
    }
    columns {
      header: "Outcome"
      field_path: "outcome"
      pref_width: 10
    }
  }
}

# ============================================================
# ENVELOPES — the hero table. Every quantity whose bounds
# intersect to nothing, with the deficit and how many
# disciplines contributed.
#
# `recorded` is the subject of the envelope-unrecorded gate: an
# infeasibility with no au:Conflict naming it is the one thing
# that must never exist. Showing the flag means the board
# displays what the gate is about, not merely its verdict.
#
# The rich version of this surface — constraint bars on a shared
# axis with the intersection drawn — is a stage-3 adhoc panel.
# A table carries the same facts and ships now.
# ============================================================
panels {
  panel_id: "envelopes"
  title: "Envelopes"
  table {
    populate {
      service: "spec.v1.Authoring"
      method: "ListEnvelopes"
    }
    rows_field: "envelopes"
    item_noun: "empty envelopes"
    placeholder: "No empty feasible envelopes — every quantity's bounds intersect."
    columns {
      header: "Project"
      field_path: "project"
      pref_width: 10
    }
    columns {
      header: "Quantity"
      field_path: "quantity"
      pref_width: 26
    }
    columns {
      header: "Unit"
      field_path: "unit"
      pref_width: 6
    }
    columns {
      header: "Requires ≥"
      field_path: "greatest_lower"
      pref_width: 11
    }
    columns {
      header: "Permits ≤"
      field_path: "least_upper"
      pref_width: 10
    }
    columns {
      header: "Deficit"
      field_path: "deficit"
      pref_width: 9
    }
    columns {
      header: "Disc."
      field_path: "disciplines"
      pref_width: 6
    }
    columns {
      header: "Recorded"
      field_path: "recorded"
      pref_width: 9
    }
  }
}

# ============================================================
# FRONTIER — every claim below the binding rung, with the
# blocker it names, ranked by how many claims reference it.
#
# ladder-integrity.rq makes an unnamed stall a build failure
# precisely so this table can never show a row whose only
# content is "not done".
# ============================================================
panels {
  panel_id: "frontier"
  title: "Frontier"
  table {
    populate {
      service: "spec.v1.Authoring"
      method: "ListStalls"
    }
    rows_field: "stalls"
    item_noun: "stalls"
    placeholder: "No open stalls — every claim is at or above the binding rung."
    columns {
      header: "Project"
      field_path: "project"
      pref_width: 10
    }
    columns {
      header: "Claim"
      field_path: "claim_id"
      pref_width: 30
    }
    columns {
      header: "Rung"
      field_path: "rung"
      pref_width: 6
    }
    columns {
      header: "Discipline"
      field_path: "discipline"
      pref_width: 30
    }
    columns {
      header: "Blocked on"
      field_path: "stalled_on"
      pref_width: 56
    }
    columns {
      header: "Deps"
      field_path: "dependent_count"
      pref_width: 6
    }
  }
}

# ============================================================
# DISCIPLINES — the atlas as a table. The faceted lattice with
# a conflict-heat overlay is a stage-3 adhoc panel; the numbers
# that matter are tabular.
#
# `typed_pct` is the leading indicator, and the most useful
# column here: a discipline whose claims do not constrain a
# declared au:Quantity cannot participate in empty-envelope
# detection AT ALL, so its conflicts are invisible rather than
# absent. Over corpus/ampere, metering & settlement reads 0.0%
# — and it is the discipline that fixes the referent for every
# energy quantity in the corpus.
# ============================================================
panels {
  panel_id: "disciplines"
  title: "Disciplines"
  table {
    populate {
      service: "spec.v1.Authoring"
      method: "ListDisciplines"
    }
    rows_field: "disciplines"
    item_noun: "disciplines"
    placeholder: "No disciplines declared."
    columns {
      header: "Project"
      field_path: "project"
      pref_width: 10
    }
    columns {
      header: "Discipline"
      field_path: "discipline"
      pref_width: 34
    }
    columns {
      header: "Steward"
      field_path: "steward"
      pref_width: 20
    }
    columns {
      header: "Claims"
      field_path: "claim_count"
      pref_width: 7
    }
    columns {
      header: "Typed %"
      field_path: "typed_pct"
      pref_width: 8
    }
    columns {
      header: "Hard"
      field_path: "non_defeasible_count"
      pref_width: 6
    }
    columns {
      header: "Dark %"
      field_path: "dark_pct"
      pref_width: 7
    }
  }
}

# ============================================================
# CLAIMS — the corpus itself. Deliberately last in the nav:
# with thousands of claims a flat list is the least useful
# surface, and the point of the three above is that you rarely
# need it. Kept because "show me everything" is a legitimate
# escape hatch when the faceted views mislead.
# ============================================================
panels {
  panel_id: "claims"
  title: "Claims"
  table {
    populate {
      service: "spec.v1.Authoring"
      method: "ListClaims"
    }
    rows_field: "claims"
    item_noun: "claims"
    placeholder: "No normative statements indexed."
    columns {
      header: "Project"
      field_path: "project"
      pref_width: 10
    }
    columns {
      header: "Claim"
      field_path: "claim_id"
      pref_width: 28
    }
    columns {
      header: "Discipline"
      field_path: "discipline"
      pref_width: 28
    }
    columns {
      header: "Modality"
      field_path: "modality"
      pref_width: 10
    }
    columns {
      header: "Rung"
      field_path: "rung"
      pref_width: 6
    }
    columns {
      header: "Quantity"
      field_path: "quantity"
      pref_width: 24
    }
    columns {
      header: "Instrument"
      field_path: "instrument"
      pref_width: 24
    }
    columns {
      header: "Defeasible"
      field_path: "defeasible"
      pref_width: 10
    }
  }
}

# ============================================================
# WITNESS — one conflict's parties with their bounds. A table,
# so it ships in stage 1; the axis drawing waits for stage 3.
#
# The `defeasible` column is what makes it actionable rather
# than merely alarming: a non-defeasible bound cannot be traded
# away at any price, so the decision is only ever between the
# ones that can.
#
# MERIDIAN NOTE: this panel wants a parameter (which conflict?).
# The declarative `populate` block carries no argument, so
# stage 1 serves ALL parties of ALL conflicts with a
# conflict_id column and lets the reader scan. Per-conflict
# drill-down is a stage-2 concern — see RFC-002a on whether
# meridian's populate can take a selection argument.
# ============================================================
panels {
  panel_id: "witness"
  title: "Witnesses"
  table {
    populate {
      service: "spec.v1.Authoring"
      method: "GetConflictWitness"
    }
    rows_field: "parties"
    item_noun: "witness parties"
    placeholder: "No conflict parties to witness."
    columns {
      header: "Project"
      field_path: "project"
      pref_width: 10
    }
    columns {
      header: "Conflict"
      field_path: "conflict_id"
      pref_width: 10
    }
    columns {
      header: "Quantity"
      field_path: "quantity"
      pref_width: 22
    }
    columns {
      header: "Claim"
      field_path: "claim_id"
      pref_width: 28
    }
    columns {
      header: "Discipline"
      field_path: "discipline"
      pref_width: 28
    }
    columns {
      header: "Modality"
      field_path: "modality"
      pref_width: 10
    }
    columns {
      header: "Bound"
      field_path: "bound_kind"
      pref_width: 11
    }
    columns {
      header: "Value"
      field_path: "bound_value"
      pref_width: 8
    }
    columns {
      header: "Guard"
      field_path: "guard"
      pref_width: 26
    }
    columns {
      header: "Defeasible"
      field_path: "defeasible"
      pref_width: 10
    }
  }
}
