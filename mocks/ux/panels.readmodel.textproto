# panels.readmodel.textproto — STAGE 1 of browser authoring: the authoring READ
# MODEL as declarative meridian table panels.
#
# ── Why this file is separate from panels.authoring.textproto ────────────────
#
# panels.authoring.textproto is the aspirational bundle: it needs `adhoc` handlers
# registered in botnoc-web's main.js ADHOC_HANDLERS registry — a change in ANOTHER
# REPO — plus, for the richest surfaces, a meridian descriptor extension owned
# upstream in meridian_schemas.
#
# THIS bundle needs neither. Every panel is a plain `table`, populated from spec's
# own web routes, exactly like plugin-mycelium — whose panels.textproto states the
# property outright: "DECLARATIVE table panels ... No shell-side (main.js) code."
#
# So this is the part of browser authoring that is unblocked TODAY. It is
# read-only, and read-only is most of the value: the conflict board, the empty
# envelopes, the frontier, and per-discipline coverage are the outputs people
# actually need to see. Writing comes at stage 3.
#
# ── What backs it ───────────────────────────────────────────────────────────
#
# tools/readmodel/emit_readmodel.py computes these rows with SPARQL and emits one
# JSON file per route in the envelope services/spec/src/json.rs already uses.
# The plugin serves files; the build does the RDF work. Verified against
# corpus/ampere: 12 conflicts, 2 envelopes, 5 stalls, 12 disciplines, 64 claims,
# 33 witness parties.
#
# Each `populate.service/.method` pair below must appear in the plugin's
# /describe `web_routes`; emit_readmodel.py writes that fragment as
# describe.web_routes.json so the two cannot drift.
#
# Ready to move to services/spec/ui/ as a second meridian_panel_bundle once
# someone can build it — see RFC-002a for the sequencing.

# ============================================================
# CONFLICTS — the board. Sorted server-side by blocked work
# orders: a conflict matters in proportion to how much
# construction it stops.
#
# `state` is derived, not stored — a conflict with no
# au:Resolution is open. RFC-002 §7 deliberately keeps
# UNRESOLVED a measure rather than a gate, so "open" is a
# legitimate steady state and the board must show it without
# implying failure.
# ============================================================
panels {
  panel_id: "conflicts"
  title: "Conflicts"
  table {
    populate {
      service: "spec.v1.Authoring"
      method: "ListConflicts"
    }
    rows_field: "conflicts"
    item_noun: "conflicts"
    placeholder: "No cross-discipline conflicts recorded."
    columns {
      header: "ID"
      field_path: "id"
      pref_width: 10
    }
    columns {
      header: "Kind"
      field_path: "kind"
      pref_width: 20
    }
    columns {
      header: "Disciplines"
      field_path: "disciplines"
      pref_width: 44
    }
    columns {
      header: "Parties"
      field_path: "party_count"
      pref_width: 8
    }
    columns {
      header: "Blocks"
      field_path: "blocked_orders"
      pref_width: 7
    }
    columns {
      header: "Owner"
      field_path: "owner"
      pref_width: 18
    }
    columns {
      header: "State"
      field_path: "state"
      pref_width: 9
    }
    columns {
      header: "Outcome"
      field_path: "outcome"
      pref_width: 10
    }
  }
}

# ============================================================
# ENVELOPES — the hero table. Every quantity whose bounds
# intersect to nothing, with the deficit and how many
# disciplines contributed.
#
# `recorded` is the subject of the envelope-unrecorded gate: an
# infeasibility with no au:Conflict naming it is the one thing
# that must never exist. Showing the flag means the board
# displays what the gate is about, not merely its verdict.
#
# The rich version of this surface — constraint bars on a shared
# axis with the intersection drawn — is a stage-3 adhoc panel.
# A table carries the same facts and ships now.
# ============================================================
panels {
  panel_id: "envelopes"
  title: "Envelopes"
  table {
    populate {
      service: "spec.v1.Authoring"
      method: "ListEnvelopes"
    }
    rows_field: "envelopes"
    item_noun: "empty envelopes"
    placeholder: "No empty feasible envelopes — every quantity's bounds intersect."
    columns {
      header: "Quantity"
      field_path: "quantity"
      pref_width: 26
    }
    columns {
      header: "Unit"
      field_path: "unit"
      pref_width: 6
    }
    columns {
      header: "Requires ≥"
      field_path: "greatest_lower"
      pref_width: 11
    }
    columns {
      header: "Permits ≤"
      field_path: "least_upper"
      pref_width: 10
    }
    columns {
      header: "Deficit"
      field_path: "deficit"
      pref_width: 9
    }
    columns {
      header: "Disc."
      field_path: "disciplines"
      pref_width: 6
    }
    columns {
      header: "Recorded"
      field_path: "recorded"
      pref_width: 9
    }
  }
}

# ============================================================
# FRONTIER — every claim below the binding rung, with the
# blocker it names, ranked by how many claims reference it.
#
# ladder-integrity.rq makes an unnamed stall a build failure
# precisely so this table can never show a row whose only
# content is "not done".
# ============================================================
panels {
  panel_id: "frontier"
  title: "Frontier"
  table {
    populate {
      service: "spec.v1.Authoring"
      method: "ListStalls"
    }
    rows_field: "stalls"
    item_noun: "stalls"
    placeholder: "No open stalls — every claim is at or above the binding rung."
    columns {
      header: "Claim"
      field_path: "claim_id"
      pref_width: 30
    }
    columns {
      header: "Rung"
      field_path: "rung"
      pref_width: 6
    }
    columns {
      header: "Discipline"
      field_path: "discipline"
      pref_width: 30
    }
    columns {
      header: "Blocked on"
      field_path: "stalled_on"
      pref_width: 56
    }
    columns {
      header: "Deps"
      field_path: "dependent_count"
      pref_width: 6
    }
  }
}

# ============================================================
# DISCIPLINES — the atlas as a table. The faceted lattice with
# a conflict-heat overlay is a stage-3 adhoc panel; the numbers
# that matter are tabular.
#
# `typed_pct` is the leading indicator, and the most useful
# column here: a discipline whose claims do not constrain a
# declared au:Quantity cannot participate in empty-envelope
# detection AT ALL, so its conflicts are invisible rather than
# absent. Over corpus/ampere, metering & settlement reads 0.0%
# — and it is the discipline that fixes the referent for every
# energy quantity in the corpus.
# ============================================================
panels {
  panel_id: "disciplines"
  title: "Disciplines"
  table {
    populate {
      service: "spec.v1.Authoring"
      method: "ListDisciplines"
    }
    rows_field: "disciplines"
    item_noun: "disciplines"
    placeholder: "No disciplines declared."
    columns {
      header: "Discipline"
      field_path: "discipline"
      pref_width: 34
    }
    columns {
      header: "Steward"
      field_path: "steward"
      pref_width: 20
    }
    columns {
      header: "Claims"
      field_path: "claim_count"
      pref_width: 7
    }
    columns {
      header: "Typed %"
      field_path: "typed_pct"
      pref_width: 8
    }
    columns {
      header: "Hard"
      field_path: "non_defeasible_count"
      pref_width: 6
    }
    columns {
      header: "Dark %"
      field_path: "dark_pct"
      pref_width: 7
    }
  }
}

# ============================================================
# CLAIMS — the corpus itself. Deliberately last in the nav:
# with thousands of claims a flat list is the least useful
# surface, and the point of the three above is that you rarely
# need it. Kept because "show me everything" is a legitimate
# escape hatch when the faceted views mislead.
# ============================================================
panels {
  panel_id: "claims"
  title: "Claims"
  table {
    populate {
      service: "spec.v1.Authoring"
      method: "ListClaims"
    }
    rows_field: "claims"
    item_noun: "claims"
    placeholder: "No normative statements indexed."
    columns {
      header: "Claim"
      field_path: "claim_id"
      pref_width: 28
    }
    columns {
      header: "Discipline"
      field_path: "discipline"
      pref_width: 28
    }
    columns {
      header: "Modality"
      field_path: "modality"
      pref_width: 10
    }
    columns {
      header: "Rung"
      field_path: "rung"
      pref_width: 6
    }
    columns {
      header: "Quantity"
      field_path: "quantity"
      pref_width: 24
    }
    columns {
      header: "Instrument"
      field_path: "instrument"
      pref_width: 24
    }
    columns {
      header: "Defeasible"
      field_path: "defeasible"
      pref_width: 10
    }
  }
}

# ============================================================
# WITNESS — one conflict's parties with their bounds. A table,
# so it ships in stage 1; the axis drawing waits for stage 3.
#
# The `defeasible` column is what makes it actionable rather
# than merely alarming: a non-defeasible bound cannot be traded
# away at any price, so the decision is only ever between the
# ones that can.
#
# MERIDIAN NOTE: this panel wants a parameter (which conflict?).
# The declarative `populate` block carries no argument, so
# stage 1 serves ALL parties of ALL conflicts with a
# conflict_id column and lets the reader scan. Per-conflict
# drill-down is a stage-2 concern — see RFC-002a on whether
# meridian's populate can take a selection argument.
# ============================================================
panels {
  panel_id: "witness"
  title: "Witnesses"
  table {
    populate {
      service: "spec.v1.Authoring"
      method: "GetConflictWitness"
    }
    rows_field: "parties"
    item_noun: "witness parties"
    placeholder: "No conflict parties to witness."
    columns {
      header: "Conflict"
      field_path: "conflict_id"
      pref_width: 10
    }
    columns {
      header: "Claim"
      field_path: "claim_id"
      pref_width: 28
    }
    columns {
      header: "Discipline"
      field_path: "discipline"
      pref_width: 28
    }
    columns {
      header: "Modality"
      field_path: "modality"
      pref_width: 10
    }
    columns {
      header: "Bound"
      field_path: "bound_kind"
      pref_width: 11
    }
    columns {
      header: "Value"
      field_path: "bound_value"
      pref_width: 8
    }
    columns {
      header: "Guard"
      field_path: "guard"
      pref_width: 26
    }
    columns {
      header: "Defeasible"
      field_path: "defeasible"
      pref_width: 10
    }
  }
}
