load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "check_conformance.py",
    "decomposition_cases.json",
    "evaluation_cases.json",
    "overlay_cases.json",
])

# The shared cases, as data. Both implementations execute THESE rather than a
# hand-ported copy — see conformance/README.md for why porting the tests
# alongside the logic is the failure mode this replaces.
filegroup(
    name = "cases",
    srcs = [
        # ⛔ decomposition_cases.json is the one set of cases BOTH runners
        # actually execute on an ordinary PR: the checker imports
        # tools/import/decompose.py and calls it, and console/test runs the
        # TypeScript half. Everywhere else the second runner needs a credential
        # that has been skipping.
        "decomposition_cases.json",
        "evaluation_cases.json",
        "overlay_cases.json",
    ],
)

# ⛔ This gate exists because the other one cannot be relied on.
#
# //services/spec:spec_test is where the Rust half of the conformance suite runs,
# and it executes only when CI can mint a token for the private plugin crates —
# a step that is `continue-on-error` and has been skipping. So on an ordinary PR
# the TypeScript half runs and the Rust half does not, and a divergence
# introduced on the Rust side is reported by nothing.
#
# This target needs no crate registry, no protoc and no Rust toolchain: it parses
# the constants out of both sources and re-derives every evaluation verdict from
# them. Dropping `Examined` from POSITIVE — a one-word edit that silently permits
# a vacuous pass under a quieter name — fails three checks here, on a normal PR.
#
# ⚠ It checks the DATA the rule is made of, not the control flow that reads it.
# Reordering the guards in `evaluation::check` so the zero-check is unreachable
# passes this and fails only //services/spec:spec_test. Do not read a green here
# as the refusal being exercised.
# ⚠ EVERY FILE THE CHECKER READS MUST BE HERE.
#
# Under `bazel test` there is no BUILD_WORKSPACE_DIRECTORY, so the script runs
# against the runfiles tree and sees only what this list stages. Getting it wrong
# fails in two different ways and only one of them is loud:
#
#   a read with no guard   crashes the test (which is how this list got fixed)
#   a read behind exists() SKIPS, silently, while passing on a laptop
#
# The second is the one that matters. `//console:conformance_inputs` and
# `//:.github/workflows/ci.yml` were both missing, so the Rust↔TypeScript constant
# comparison and the bundle drift check ran nowhere in CI. Add to this list
# whenever the checker learns to read something new.
sh_test(
    name = "conformance_test",
    size = "small",
    srcs = ["conformance_test.sh"],
    data = [
        "check_conformance.py",
        ":cases",
        "//:.github/workflows/ci.yml",
        "//console:conformance_inputs",
        "//rdf/lint/authoring:vacuous-invariant.rq",
        "//services/spec:src",
        # ⛔ IMPORTED AND CALLED, not parsed. The checker executes the shared
        # decomposition cases against the real corpus decomposer, so a missing
        # stage here is a crash rather than a silent skip — which is the loud
        # failure of the two this list's comment describes, and is how this entry
        # came to be written.
        "//tools/import:decompose.py",
        "//tools/proposals:materialize.py",
    ],
)
