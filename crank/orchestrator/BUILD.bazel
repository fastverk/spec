load("@rules_java//java:defs.bzl", "java_binary", "java_library", "java_test")

package(default_visibility = ["//visibility:public"])

JENA_DEPS = [
    "@maven//:org_apache_jena_jena_arq",
    "@maven//:org_apache_jena_jena_core",
    "@maven//:org_apache_jena_jena_base",
    "@maven//:org_apache_jena_jena_iri",
    "@maven//:org_slf4j_slf4j_simple",
]

# The crank loop driver (predict → project → gate → measure, τ↓), compiling
# against the contract's Java bindings (//crank/proto:crank_java_proto). The
# predictor is the CrankPredictor interface; the measure + gate are the
# EnergyModel / Gate interfaces (HeuristicEnergy is the dependency-free default).
# Swap MockPredictor for the gRPC stub, or the heuristic for JenaEnergy/JenaGate,
# and the loop is unchanged. No Jena dep here — that lives in :jena_measure.
java_library(
    name = "orchestrator",
    srcs = [
        "CrankOrchestrator.java",
        "CrankPredictor.java",
        "EnergyModel.java",
        "Gate.java",
        "HeuristicEnergy.java",
        "MockPredictor.java",
    ],
    deps = ["//crank/proto:crank_java_proto"],
)

# The REAL measure + gate: ARQ SPARQL over a Jena model of the crank graph, the
# same queries the //corpus energy/consistency targets use. Kept separate so the
# loop library stays Jena-free; the orchestrator takes these via its 4-arg ctor.
java_library(
    name = "jena_measure",
    srcs = [
        "JenaEnergy.java",
        "JenaGate.java",
        "JenaGraph.java",
    ],
    deps = [
        ":orchestrator",
        "//crank/proto:crank_java_proto",
    ] + JENA_DEPS,
)

# Runs the loop with the in-process mock fleet and asserts it converges + E(G)
# descends. use_testrunner=False so the plain main() IS the test (no junit dep).
java_test(
    name = "crank_check",
    srcs = ["CrankCheck.java"],
    main_class = "dev.fastverk.crank.orchestrator.CrankCheck",
    use_testrunner = False,
    deps = [
        ":orchestrator",
        "//crank/proto:crank_java_proto",
    ],
)

# Runs the loop with the REAL Jena measure + gate and asserts: the SPARQL-measured
# E(G) descends to convergence, redundancy is structural (a transitively-implied
# edge is counted and its reduction lowers E), and the gate rejects a cycle.
java_test(
    name = "jena_energy_check",
    srcs = ["JenaEnergyCheck.java"],
    main_class = "dev.fastverk.crank.orchestrator.JenaEnergyCheck",
    use_testrunner = False,
    deps = [
        ":jena_measure",
        ":orchestrator",
        "//crank/proto:crank_java_proto",
    ] + JENA_DEPS,
)

# Cranks the FULL materialized ratio corpus (ratio-corpus.ttl, bundled as a
# resource): measures real E(G) with SPARQL, grounds ungrounded claims one per
# crank (U↓), and asserts the real E(G) descends crank over crank while the
# dependsOn DAG stays acyclic. Proves the measure/gate work on the real corpus,
# not just the synthetic demo graph.
java_test(
    name = "corpus_crank",
    srcs = ["CorpusCrank.java"],
    main_class = "dev.fastverk.crank.orchestrator.CorpusCrank",
    resource_strip_prefix = "corpus",
    resources = ["//corpus:ratio-corpus.ttl"],
    use_testrunner = False,
    deps = [
        ":jena_measure",
        ":orchestrator",
        "//crank/proto:crank_java_proto",
    ] + JENA_DEPS,
)

# The gRPC transport: GrpcPredictor (client — wraps the CrankPredictorGrpc
# blocking stub as the CrankPredictor interface) + CrankPredictorService (server
# — adapts a plain CrankPredictor into the generated service base). Kept OUT of
# :orchestrator on purpose, so the loop library has zero transport deps and
# stays dial-only-the-interface; this is the layer that binds to a wire.
java_library(
    name = "grpc_transport",
    srcs = [
        "CrankPredictorService.java",
        "GrpcPredictor.java",
    ],
    deps = [
        ":orchestrator",
        "//crank/proto:crank_java_grpc",
        "//crank/proto:crank_java_proto",
        "@io_grpc_grpc_java//api",
        "@io_grpc_grpc_java//stub",
    ],
)

# The real-transport proof: stands up an in-process gRPC server bound to the
# service (delegating to MockPredictor), dials it through GrpcPredictor, and runs
# the whole crank loop over the stub — same loop as crank_check, now marshalling
# every PredictRequest/PredictResponse across the contract. Asserts it still
# converges + E(G) descends. In-process transport ⇒ hermetic + port-free.
java_test(
    name = "grpc_round_trip",
    srcs = ["GrpcRoundTrip.java"],
    main_class = "dev.fastverk.crank.orchestrator.GrpcRoundTrip",
    use_testrunner = False,
    runtime_deps = [
        "@io_grpc_grpc_java//core",
        "@io_grpc_grpc_java//netty",
    ],
    deps = [
        ":grpc_transport",
        ":orchestrator",
        "//crank/proto:crank_java_proto",
        "@io_grpc_grpc_java//api",
        "@io_grpc_grpc_java//inprocess",
    ],
)

# Dials a LIVE agora_crank endpoint over netty (cross-language: JVM orchestrator
# ⇄ Rust tonic fleet server). Needs an external server, so it is a binary, not a
# test. Start the server first, then:
#   bazel run //crank/orchestrator:grpc_dial -- 127.0.0.1:50051
java_binary(
    name = "grpc_dial",
    srcs = ["GrpcDial.java"],
    main_class = "dev.fastverk.crank.orchestrator.GrpcDial",
    runtime_deps = ["@io_grpc_grpc_java//netty"],
    deps = [
        ":grpc_transport",
        ":orchestrator",
        "//crank/proto:crank_java_proto",
        "@io_grpc_grpc_java//api",
    ],
)
