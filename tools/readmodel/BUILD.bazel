load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "check_wiring.py",
    "compile_panels.py",
    "emit_readmodel.py",
])

# ⛔ This check was written, is good, and had never run automatically.
#
# It asserts that every part of the authoring plane agrees with every other:
# the emitter's routes, the JSON payloads, /describe's web_routes, the axum
# router, the Rust ROUTES table, the nav leaves, the panel descriptors, and the
# COMPILED panel bundle. Adding one route touches seven places and the failure
# from missing any of them is a browser console reading
#
#   no gateway route for spec.v1.Authoring/ListRequirements
#
# which looks like a console bug rather than a plugin one.
#
# Running it by hand is not a gate. Adding the Requirements route in this same
# change, it caught FOUR real mistakes in one pass — a missing axum route, a
# missing nav leaf, two stale counts, and a panel bundle that had not been
# recompiled. Every one of those would have shipped.
#
# ⚠ It reads committed source, not build outputs — panels.binpb included, so it
# also catches a bundle that drifted from its textproto. That is why the data
# list looks broad: the check's whole value is spanning the seam.
sh_test(
    name = "check_wiring_test",
    size = "small",
    srcs = ["check_wiring_test.sh"],
    data = [
        "check_wiring.py",
        "emit_readmodel.py",
        "//mocks/ux:panels.authoring-form.textproto",
        "//services/spec:src",
        "//services/spec/readmodel:payloads",
        "//services/spec/ui:panels.binpb",
        "//services/spec/ui:panels.textproto",
    ],
)

# ⛔ Byte-equality between panels.textproto and the COMMITTED panels.binpb.
#
# check_wiring_test above already spans this seam, but by panel ID — which catches a
# panel present in one and absent from the other, and nothing finer. A renamed column
# header, a changed pref_width, a reworded placeholder and a corrupted string all
# leave the id list untouched, so none of them would fail that test.
#
# What makes the gap concrete rather than theoretical: byte equality is what caught a
# bug in compile_panels.py ITSELF. Its textproto parser decoded string escapes via
# `.encode("utf-8").decode("unicode_escape")`, which reads each UTF-8 byte as a
# Latin-1 codepoint — so `Requires ≥` became `Requires â‰¥` and the emitted bundle came
# out 12 bytes larger than protoc's. The committed bundle was correct throughout and
# check_wiring_test was right to pass; the byte comparison was the only thing in the
# repo sensitive enough to see the difference at all. A check that can find a fault in
# its own toolchain will find one in a descriptor.
#
# The script verifies; it never writes. Regenerating is
# `bazel build //services/spec/ui:panels` (the real compiler) or
# `python3 tools/readmodel/compile_panels.py --write` for anyone without it — the
# latter validates its own codec against protoc's committed output, and asserts its
# parser preserves UTF-8, before emitting anything.
sh_test(
    name = "compile_panels_test",
    size = "small",
    srcs = ["compile_panels_test.sh"],
    data = [
        "compile_panels.py",
        "//services/spec/ui:panels.binpb",
        "//services/spec/ui:panels.textproto",
    ],
)
