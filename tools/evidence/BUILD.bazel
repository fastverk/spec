load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "assessment",
    srcs = ["assessment.py", "execution.py"],
    deps = ["//proto/spec/v1:evidence_py_proto"],
    data = ["evaluate.py", "//proto/spec/v1:evidence.proto", "//proto/spec/v1:invariant.proto"],
)

py_binary(
    name = "evaluate",
    srcs = ["evaluate.py"],
    legacy_create_init = False,
    deps = [":assessment"],
)

py_test(
    name = "assessment_test",
    srcs = ["assessment_test.py"],
    legacy_create_init = False,
    deps = [":assessment"],
)

py_test(
    name = "cli_test",
    srcs = ["cli_test.py"],
    args = ["$(rootpath :evaluate)"],
    data = [":evaluate"],
    deps = [":assessment"],
    legacy_create_init = False,
)

py_test(
    name = "review_test",
    srcs = ["review_test.py"],
    legacy_create_init = False,
    deps = [":assessment"],
)

py_test(
    name = "execution_test",
    srcs = ["execution_test.py", "assessment_test.py"],
    main = "execution_test.py",
    args = ["$(rootpath :evaluate)"],
    data = [":evaluate"],
    deps = [":assessment"],
    legacy_create_init = False,
)
