load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

# The promotion tool: reads the append-only logs and writes
# corpus/<project>/proposals.ttl, which the gates then run over. Exported as a
# source label rather than wrapped in a py_binary because rules_python is not a
# bazel_dep here — the same reason tools/readmodel/*.py are invoked with host
# python3 (see docs/rfc-002a-browser-authoring-path.md §9, step 4).
#
# //conformance:conformance_test reads it to assert the vacuous DROP still
# exists. That refusal is one of three independent places a pass over an empty
# population is refused, and each is there because the others can be bypassed;
# losing one silently is the failure that matters.
exports_files([
    "materialize.py",
    "check_materialized.sh",
    "replay.py",
])

# ⛔ `spec replay <address>` — RFC-002 §12's P1 gate, over a FIXTURE log.
#
# Not over //logs/proposals.jsonl, which is empty until the first promotion: a
# test that ran over it would pass by examining nothing, which is the defect
# //rdf/lint/authoring:vacuous-invariant.rq exists to catch, in a test instead of
# in a corpus. The fixture PLANTS two defects and fails if either goes
# undetected — a record the door refused (which must not be promoted) and a
# record whose stored address is not the address of its own body.
#
# ⚠ The `data` list is the load-bearing part. Under `bazel test` the script sees
# exactly what is staged here; a file omitted either crashes the test or, worse,
# makes a check quietly pass over nothing.
sh_test(
    name = "replay_test",
    size = "small",
    srcs = ["replay_test.sh"],
    data = [
        "fixtures/replay-log-lying.jsonl",
        "fixtures/replay-log.jsonl",
        "materialize.py",
        "replay.py",
    ],
)
