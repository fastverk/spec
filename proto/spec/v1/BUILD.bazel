# spec.v1 — the plugin's DTO contract (proto/spec/v1/spec.proto).
#
# services/spec's build.rs compiles it via prost. Exported so the plugin's
# cargo_build_script can `data`-dep the .proto label (the macro stages it at its
# exec-root-relative path, where build.rs's `../../proto/...` resolves it).
package(default_visibility = ["//visibility:public"])

exports_files(["spec.proto"])

load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files([
    "invariant.proto",
    "grounding_adapter.proto",
    "derivation.proto",
    "workorder.proto",
])

# ⛔ The data boundary, asserted rather than remembered.
#
# spec stores invariants; it must never store a customer's rows. The grounding
# UI does need example rows (populations, not schemas — that is what makes the
# question answerable), so they exist in grounding_adapter.proto and are
# rendered and discarded.
#
# Enforced through the IMPORT GRAPH: invariant.proto imports nothing, so no type
# it can reach is declared in the adapter file. Adding a data-bearing field to
# the stored type means adding an import, and that import is the review.
sh_test(
    name = "data_boundary_test",
    size = "small",
    srcs = ["data_boundary_test.sh"],
    args = [
        "$(rootpath invariant.proto)",
        "$(rootpath grounding_adapter.proto)",
        "$(rootpath derivation.proto)",
        "$(rootpath workorder.proto)",
    ],
    data = [
        "derivation.proto",
        "grounding_adapter.proto",
        "invariant.proto",
        "workorder.proto",
    ],
)

# ── The first proto_library in this repo ───────────────────────────────────────
#
# Until now the .proto files were consumed only as SOURCE: services/spec's
# build.rs hands them to prost, and nothing asked Bazel to understand them. That
# was enough while the only consumer was one Rust crate compiling message types.
# A JVM gate service is a second consumer in a second language, and two hand-run
# codegen paths over one schema is how a "schema of record" stops being one.
#
# ⚠ DECLARED, NOT YET CONSUMED. No java_proto_library or rust_prost_library hangs
# off this today — //java:gate_cli emits the same shape as hand-written JSON
# (GateCli.toJson), deliberately, so adopting generated types later is a
# serializer swap and not a rename. Wiring codegen before there is a service to
# serve it would be scaffolding around a caller that does not exist.
#
# ⚠ `protobuf` is a dev_dependency in MODULE.bazel, so this target is available
# to this repo's own builds and NOT propagated to consumers. That is correct
# while nothing downstream generates from it, and is the thing to revisit the
# day something does.
proto_library(
    name = "derivation_proto",
    srcs = ["derivation.proto"],
    visibility = ["//visibility:public"],
)
