"""spec — shared substrate for Lean-grounded specification projects.

First content: the generic Jena/RDF corpus toolkit extracted from the
Aion repo (kg.Loader / AionPaths / Writer / GateHarness + Gates, the
kg.edit write-ops mutation primitive, and the kg.reasoner.llm adapter
SPI). Consumed by Aion (the corpus gates, lint, reasoner, lean tooling)
and by mycelium (the kg_research design-spike orchestrator) so there is
one copy instead of duplicated trees.

Future scope (per narrative/rules-spec-kg-retirement-sequencing.md in the
Aion repo): the lean_emit pipelines, the graph-integrity gate macros, and
the narrative-site builder land here too as the kg retirement completes.

## The framework / product split (0.7.0)

This module ships two things: the FRAMEWORK a consumer depends on (the Lean
spec libs, the RDF corpus toolkit + gate macros, the RFC vocabulary) and the
PRODUCT this repo happens to also build from it (the Rust console plugin, its
meridian UI, the LaTeX paper, the graph figures).

Only the framework deps are non-dev. Everything the product needs is
`dev_dependency = True`, which bzlmod does not propagate — so a consumer
resolves five modules, not sixteen, and spec's own build is unaffected because
dev deps still apply when spec is the root.

This is not hypothetical tidiness. Aion pinned itself back to 0.5.2 and said
why in its own MODULE.bazel:

    0.5.2 is a PURE RENAME of 0.5.1 — identical deps — whereas 0.6.x adds a
    Rust console plugin and a LaTeX paper, pulling rules_tectonic,
    meridian_web and rules_fastverk_plugin into every consumer's module graph
    for capabilities aion does not use.

That was a correct reading of 0.6.x, and it made the framework unadoptable by
the one repo with 1,313 normative statements in it. 0.7.0 is the answer, and
it is the same reasoning the `register_toolchains` calls below already
document — applied to the `bazel_dep`s, where it was missing.
"""

module(
    name = "spec",
    version = "0.7.0",
)

# ── FRAMEWORK deps: the surface consumers actually resolve ────────────────────
# rules_java + rules_jvm_external back //java/kg (the Jena/RDF corpus toolkit);
# rules_lean backs the //lean source labels a consumer lists in its lean_test
# srcs; rules_rdf + rules_jena back the spec_corpus_gates / spec_authoring_gates
# macros. Adding to this list widens every consumer's module graph — do it
# deliberately.

bazel_dep(name = "rules_java", version = "8.6.1")
bazel_dep(name = "rules_jvm_external", version = "6.5")

# Jena (embedded SPARQL/RDF), slf4j backend, and directories (platform
# cache paths for the LLM-response cache). Coordinates mirror Aion +
# mycelium so the lifted sources build unchanged.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
# The GATE RUNNER's Jena, pinned to rules_jena's exact version (5.2.0) rather
# than spec_maven's (5.0.0).
#
# ⛔ Two installs, on purpose, and they must never meet on one classpath. The
# Bazel gates execute under rules_jena's JenaSparql at 5.2.0; //java:gate_cli
# exists to give the SAME answer, so it links the same version. Linking
# @rules_jena//jena/sparql:result_emit directly would be better still — that is
# the exact code JenaSparql calls — but rules_jena's own Maven repo is named
# `jena_maven` and is NOT visible from this module (Bzlmod scopes use_repo to the
# declaring module), so the version has to be restated here instead. Restating it
# is a drift risk with no gate on it; see docs/rfc-005-one-engine-of-record.md §3.
maven.install(
    name = "gate_maven",
    artifacts = [
        "org.apache.jena:jena-arq:5.2.0",
        "org.apache.jena:jena-core:5.2.0",
        "org.apache.jena:jena-base:5.2.0",
        "org.apache.jena:jena-iri:5.2.0",
        "org.slf4j:slf4j-simple:2.0.13",
    ],
    fetch_sources = False,
    lock_file = "//:gate_maven_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)
use_repo(maven, "gate_maven", "unpinned_gate_maven")

maven.install(
    name = "spec_maven",
    artifacts = [
        "org.apache.jena:apache-jena-libs:5.0.0",
        "org.apache.jena:jena-shacl:5.0.0",
        "org.slf4j:slf4j-simple:2.0.13",
        "dev.dirs:directories:26",
    ],
    fetch_sources = False,
    repositories = [
        "https://repo1.maven.org/maven2",
    ],
    # Pinned so the fetch REPLAYS a lockfile instead of resolving. Coursier runs
    # as a repository rule, i.e. outside the build's Java toolchain, so the
    # `remotejdk_21` pin in .bazelrc never reaches it and `--repo_env=JAVA_HOME`
    # only forwards whatever the ambient environment happens to have. On a build
    # image with no JDK on PATH that resolution fails with "Unable to locate a
    # Java Runtime" — which is why `fastverk/build` was red on main and #16/#17
    # were both merged through it (issue #19). Replaying the lockfile needs no
    # JDK at fetch time. It also makes the maven graph reproducible, which the
    # comment above depends on: coordinates that "mirror Aion + mycelium" cannot
    # drift out from under that claim if they are pinned.
    #
    # The repo is named `spec_maven`, not the default `maven`, and that is
    # load-bearing for consumers rather than cosmetic. rules_jvm_external merges
    # every module contributing to a same-named repo: with the default name a
    # consumer resolves "the maven repository 'maven' has contributions from
    # multiple bzlmod modules ... ['protobuf', 'spec']", silently mixing
    # protobuf's artifacts into spec's, and — once a lock_file is set — failing
    # outright inside maven.bzl. agora namespaces its repo `agora_maven` for the
    # same reason.
    #
    # Regenerate with:  bazel run @spec_maven//:pin  (then rename the emitted
    # rules_jvm_external++maven+spec_maven_install.json to maven_install.json)
    lock_file = "//:maven_install.json",
)
use_repo(maven, "spec_maven")

# Lean toolchain — backs the generic spec-framework modules under lean/
# (Aion.Spec.{Universe,Predicates,Kernel,Axioms}, Aion.Corpus.Schema,
# Aion.Emit.{TtlEmit,MdEmit}), lifted from the Aion repo. These import
# nothing external (pure Lean 4 core), so the lake workspace declares no
# requires. Toolchain version matches Aion's (v4.30.0-rc2) so the modules
# compile identically whether built here or as srcs in an Aion lean_test.
# 0.3.6 ships the dep-free-lake-workspace relaxation this repo's empty
# `require` list needs.
bazel_dep(name = "rules_lean", version = "0.3.6")

lake = use_extension("@rules_lean//lean:lake.bzl", "lake")
lake.workspace(
    name = "spec_lake",
    lake_manifest = "//lean/lake:lake-manifest.json",
    lakefile = "//lean/lake:lakefile.lean",
    lean_toolchain = "//lean/lake:lean-toolchain",
)
use_repo(lake, "spec_lake")

# dev_dependency: these toolchains build SPEC, they are not part of its surface.
# A non-dev register_toolchains propagates to every transitive consumer, which
# is the D2 leak the registry gates on — and a dev registration still applies
# when spec is the ROOT, so building this repo is unaffected. Same reasoning
# rules_k8s and rules_lean document, and that gate applies to itself.
register_toolchains(
    "@spec_lake//:lean_toolchain_def",
    dev_dependency = True,
)

# rules_rdf (engine-agnostic RDF rules) + rules_jena (Jena toolchain impls).
# spec uses these to define its corpus gate library declaratively: an
# rdf_dataset over the RFC vocabulary + a spec_corpus_gates macro wiring
# rdf_validate_test (SHACL shapes) + sparql_query_test (consistency queries)
# over the ontology files it hosts under rdf/.
bazel_dep(name = "rules_rdf", version = "0.3.0")
bazel_dep(name = "rules_jena", version = "0.3.2")

# Paper toolchain: tectonic compiles the crystallization whitepaper
# (//paper:crystallization, formalizing docs/rfc-001b) to PDF. rules_*
# modules don't propagate use_repo, so the extension + toolchain are wired
# here. Resolves from the same fastverk registry as rules_lean/rdf/jena.
# sh_test for //lean:audit_proofs_test (the proof gate). Native sh_test was
# removed in Bazel 9. Dev-scoped: consumers use spec's Lean SOURCES, never its
# own gates.
bazel_dep(name = "rules_shell", version = "0.6.1", dev_dependency = True)

bazel_dep(name = "rules_tectonic", version = "0.2.0", dev_dependency = True)

tectonic = use_extension(
    "@rules_tectonic//tectonic:extensions.bzl",
    "tectonic",
    dev_dependency = True,
)
use_repo(tectonic, "tectonic")

register_toolchains(
    "@tectonic//:tectonic_toolchain_def",
    dev_dependency = True,
)

# Graph rendering: rules_graphviz renders the authored .dot spec-graph figures
# (//graph) hermetically (WASM graphviz under a bun runtime — no host `dot`) to
# SVG, the canonical web-/SPARQL-regenerable render, and to `plain`, which
# //graph:plain_to_tikz turns into the TikZ the deck (//deck) embeds.
#
# NOT to PDF: `svg_pdf` and `dot_pdf` cannot build for any consumer — the
# vendored bun bundle hardcodes an absolute `__dirname` into the machine that
# built it and pdfkit reads its font metrics from there at run time. See
# //graph:BUILD.bazel.
#
# 0.2.0 (the svg_pdf/dot_pdf vector-PDF path) is published to the registry, so it
# resolves like every other module — no override. The old local_path_override
# pointed at a sibling working tree, which made this repo build ONLY on a machine
# that happened to have ../rules_graphviz checked out: the build runner failed with
# `The repository's path is "../rules_graphviz" (absolute: "/work/rules_graphviz")
# but it does not exist`, which is why the spec plugin image could not be built by
# CI and had to be produced by hand.
bazel_dep(name = "rules_graphviz", version = "0.2.0", dev_dependency = True)

# The crank predict contract + its gRPC engine/services moved to the dedicated
# `crank` repo (github:fastverk/crank — //proto, //engine, //deploy/helm). spec
# keeps the substrate the crank builds on: the Lean corrector proof
# (lean/Spec/Compaction), the RDF corpus toolkit + gates, and the RFC vocabulary.
# What remains here is the RDF-gate-side worked crank (//crank: crank_003 gates +
# measure over the materialized ratio corpus), which needs only rules_rdf.

# ── Rust console plugin: services/spec (the fastverk `spec` plugin) ────────────
# repos/spec also hosts the Rust/axum plugin backend that surfaces the estate's
# formal specs in the fastverk console (Specs / Contracts / Proof-Status). It
# builds with the promoted `fastverk_plugin` macro (rules_fastverk_plugin) and its
# own isolated crate_universe; plain `cargo` builds the same workspace for local
# iteration against a source tree ($SPEC_SOURCE_ROOT).
#
# Every dep from here down is `dev_dependency = True`: the plugin is a PRODUCT
# built in this repo, not part of the framework surface. bzlmod does not
# propagate a dependency's dev deps, so Aion and mycelium resolve none of them,
# while spec's own build is unaffected (dev deps apply when spec is root).
#
# This block used to carry the note "these deps enlarge the module graph for
# spec's consumers (Aion, mycelium)" — accurate, and it cost the framework its
# biggest consumer. See the module docstring.
# ── Hermetic C++ (zig cc) ─────────────────────────────────────────────────────
# services/spec compiles protoc/upb FROM SOURCE in the exec config (it has
# proto_data). Without a hermetic exec C++ toolchain the host GCC compiles upb and
# the build fails outright with `absolute path inclusion(s) found` (it pulls
# /usr/lib/gcc/.../stddef.h). Registering zig globally gives exec a hermetic
# compiler with correct builtins. This is safe ONLY paired with the
# `--no-gc-sections` linkopts in .bazelrc (zig/lld otherwise GCs protobuf's upb
# linkarr → `undefined reference upb_ExtensionRegistry_AddAllLinkedExtensions`).
# Mirrors plugin-forge/plugin-tbzl/plugin-polyglot/botnoc/agents.
# ⚠ NOT dev-scoped, unlike everything else in this block, and not by choice:
# hermetic_cc_toolchain's extension declares a non-empty `root_module_direct_deps`
# unconditionally, so a dev-only usage fails resolution outright with
# "root_module_direct_deps must be empty if the root module contains no usages
# with dev_dependency = False". So the module stays in a consumer's graph — but
# only the module: `register_toolchains` below IS dev, so no consumer registers
# or fetches the zig toolchain. One module of leakage, visible rather than
# silent; fixable upstream in hermetic_cc_toolchain.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.1.0")

# Two proxies, deliberately. The extension only generates `zig_sdk` for the ROOT
# module, so a non-dev `use_repo` breaks every consumer with "module extension
# ... does not generate repository zig_sdk". But a dev-ONLY usage trips the
# assertion above. So: a bare non-dev proxy satisfies the assertion and imports
# nothing, and the dev proxy carries the `use_repo` that only spec-as-root needs.
_zig_nondev = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")

zig_toolchains = use_extension(
    "@hermetic_cc_toolchain//toolchain:ext.bzl",
    "toolchains",
    dev_dependency = True,
)
use_repo(zig_toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.28",
    "@zig_sdk//toolchain:linux_arm64_gnu.2.28",
    dev_dependency = True,
)

bazel_dep(name = "rules_rust", version = "0.70.0", dev_dependency = True)
bazel_dep(name = "protobuf", version = "33.4", dev_dependency = True)
bazel_dep(name = "rules_oci", version = "2.2.6", dev_dependency = True)

# The JRE base for //java:gate_image.
#
# ⛔ PINNED BY DIGEST, not by the `nonroot` tag it was resolved from. A tag is a
# moving pointer: the image behind `nonroot` changes, and a build that reproduced
# last week would silently produce a different runtime this week. `crane digest`
# resolves it; re-run that to bump, and note the resolved value is a sha256:… —
# crane prints its ERRORS on stdout too, so a "digest" that does not start with
# sha256: is an error message being pinned as a base image.
#
# distroless/java21: no shell, no package manager, and a JRE rather than a JDK.
# gate_binary is a fat deploy jar, so nothing needs to compile at runtime.
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci", dev_dependency = True)
oci.pull(
    name = "java_base",
    digest = "sha256:7e37784d94dccbf5ccb195c73b295f5ad00cd266512dfbac12eb9c3c28f8077d",
    image = "gcr.io/distroless/java21-debian12",
    platforms = ["linux/amd64", "linux/arm64/v8"],
)
use_repo(oci, "java_base", "java_base_linux_amd64")
bazel_dep(name = "rules_pkg", version = "1.0.1", dev_dependency = True)
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5", dev_dependency = True)

# The meridian PanelBundle rule + the uiview schema the bundle compiles against.
bazel_dep(name = "meridian_web", version = "0.12.0", dev_dependency = True)
bazel_dep(name = "meridian_schemas", version = "0.24.0", dev_dependency = True)

# The portable fastverk_plugin macro + rust_service_image. Published to the
# fastverk bazel-registry (github:tomato-bazel/rules_fastverk_plugin @ 0.0.1), so
# it resolves from the registry like every other module — no override needed.
bazel_dep(name = "rules_fastverk_plugin", version = "0.0.1", dev_dependency = True)

rust = use_extension(
    "@rules_rust//rust:extensions.bzl",
    "rust",
    dev_dependency = True,
)
rust.toolchain(
    edition = "2021",
    versions = ["1.95.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains(
    "@rust_toolchains//:all",
    dev_dependency = True,
)

# crate_universe over the plugin's Cargo workspace. isolate = True keeps spec's
# universe from colliding with a consumer's.
crate = use_extension(
    "@rules_rust//crate_universe:extension.bzl",
    "crate",
    isolate = True,
    dev_dependency = True,
)
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
        "//:Cargo.toml",
        "//services/spec:Cargo.toml",
    ],
)
use_repo(crate, "crates")
