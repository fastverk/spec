load("@rules_rdf//rdf:dataset.bzl", "rdf_dataset")
load("@rules_rdf//sparql:defs.bzl", "sparql_query_test")
load("//rdf:authoring_gates.bzl", "spec_authoring_gates")
load("//rdf:gates.bzl", "spec_corpus_gates")

package(default_visibility = ["//visibility:public"])

# ── The controls ────────────────────────────────────────────────────────────
#
# Following grounding/BUILD.bazel's adversarial_gate discipline: a gate that has
# never been shown to reject anything is an assertion, not a check — and a gate
# that fires on both fixtures is a false-positive generator. So both directions
# are wired.
#
#   bazel test //rdf/lint/authoring/fixtures/...

# The incoherent slice: four instruments whose bounds on one quantity intersect
# to nothing, plus one planted instance of every hygiene and ladder defect.
rdf_dataset(
    name = "conflict_fixture",
    srcs = ["envelope-conflict.ttl"],
    in_format = "turtle",
    deps = ["//rdf:authoring_vocab"],
)

# The same slice, honestly adjudicated: the capacity commitment re-offered down
# to the binding warranty ceiling, the homonym pair registered disjoint, every
# rung provenanced, every sub-R4 claim naming its blocker, and the conflict
# retained with a witness, an owner and a resolution.
rdf_dataset(
    name = "clean_fixture",
    srcs = ["envelope-clean.ttl"],
    in_format = "turtle",
    deps = ["//rdf:authoring_vocab"],
)

# ── Negative control: every gate silent on the coherent fixture ─────────────
#
# This is the direction that proves the gates do not false-positive. It cannot
# prove they detect anything — a gate that always returns zero passes it
# trivially — which is what :expect_detections below is for.
spec_authoring_gates(
    name = "clean",
    dataset = ":clean_fixture",
    measures = False,
)

# The clean fixture is also structurally sound, so the pre-existing suite runs
# over it too. Cheap, and it catches a fixture that only looks valid.
spec_corpus_gates(
    name = "clean_structural",
    dataset = ":clean_fixture",
)

# ── Positive control: the gates detect EXACTLY the planted defects ──────────
#
# Zero-row iff every gate's detection count over the conflict fixture is the
# expected one. Fails if a gate stops detecting (a body regression) AND if it
# starts over-detecting. Written as counted assertions in the same zero-row
# idiom as everything else, rather than an emit_diff_test against a golden TSV,
# so it carries no dependency on the SPARQL engine's TSV serialization.
#
# Verified behaviour: 0 rows over :conflict_fixture, 5 rows over :clean_fixture
# (the assertions are live — absent detections fire them).
sparql_query_test(
    name = "expect_detections",
    dataset = ":conflict_fixture",
    query = "expect-detections.rq",
)

# NOTE: the "envelope-unrecorded must stay silent on the conflict fixture"
# assertion is NOT wired as its own target. It would need
# query = "//rdf/lint/authoring:envelope-unrecorded.rq" — a query label from
# another package — and whether sparql_query_test accepts that is untested here.
# The property is already covered: :clean runs envelope_unrecorded over the clean
# fixture, and expect-detections.rq pins every detection count over the conflict
# fixture. Wire it once someone has a green build to iterate against.

exports_files(glob([
    "*.ttl",
    "*.rq",
]))
