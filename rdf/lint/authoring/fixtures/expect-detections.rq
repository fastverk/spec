# ---
# title: "Authoring-gate detection counts (adversarial control)"
# description: "Zero-row iff the authoring gates detect EXACTLY the defects planted in envelope-conflict.ttl. Fails if a gate stops detecting, or starts over-detecting."
# severity: error
# tier: 3
# rationale: "The negative control (envelope-clean.ttl returning zero rows from every gate) proves the gates do not false-positive. It cannot prove they detect anything at all — a gate that always returns zero passes it trivially. This is the positive control, in the same zero-row idiom the rest of the suite uses: run each gate's body over the planted fixture, count, and emit a row if the count is not the expected one. Written as counted assertions rather than an emit_diff_test against a golden TSV so it carries no dependency on the SPARQL engine's TSV serialization. Expected counts are one row per DEFECT, not per subject, which is why two exceed the number of defect kinds: bad-unprovenanced carries both UNPROVENANCED-RUNG and UNNAMED-STALL, and conflict-unwitnessed carries UNWITNESSED, UNOWNED and UNRESOLVED. If you change a gate's body, this file must change with it — that coupling is the point. tier-rung-coherence = 1: the one Derivational-below-R4 claim; the clean fixture's three legal tier/rung pairs must stay silent."
# ---
PREFIX rfc: <https://aion.savvi.io/ontology/rfc#>
PREFIX au:  <https://aion.savvi.io/ontology/authoring#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?check ?expected ?actual
WHERE {
  {
    # empty-envelope.rq must find exactly the one planted infeasibility, and
    # must compute its deficit as 27.0 MW across 4 disciplines.
    {
      SELECT (COUNT(*) AS ?actual)
      WHERE {
        {
          SELECT ?q (MAX(?v) AS ?gl)
          WHERE {
            ?c a rfc:NormativeStatement ; au:constrains ?q ; au:hasBound ?b .
            ?b au:boundKind au:LowerBound ; au:boundValue ?v .
          }
          GROUP BY ?q
        }
        {
          SELECT ?q (MIN(?v) AS ?lu)
          WHERE {
            ?c a rfc:NormativeStatement ; au:constrains ?q ; au:hasBound ?b .
            ?b au:boundKind au:UpperBound ; au:boundValue ?v .
          }
          GROUP BY ?q
        }
        ?q a au:Quantity .
        FILTER(?gl > ?lu)
      }
    }
    BIND("empty-envelope" AS ?check)
    BIND(1 AS ?expected)
    FILTER(?actual != ?expected)
  }
  UNION
  {
    # The planted deficit must be exactly 27.0 on q-sustained-discharge. Guards
    # against a bounds-arithmetic regression that still reports "one envelope".
    {
      SELECT (COUNT(*) AS ?actual)
      WHERE {
        {
          SELECT ?q (MAX(?v) AS ?gl)
          WHERE {
            ?c a rfc:NormativeStatement ; au:constrains ?q ; au:hasBound ?b .
            ?b au:boundKind au:LowerBound ; au:boundValue ?v .
          }
          GROUP BY ?q
        }
        {
          SELECT ?q (MIN(?v) AS ?lu)
          WHERE {
            ?c a rfc:NormativeStatement ; au:constrains ?q ; au:hasBound ?b .
            ?b au:boundKind au:UpperBound ; au:boundValue ?v .
          }
          GROUP BY ?q
        }
        ?q a au:Quantity ; au:unit "MW" .
        FILTER(?gl - ?lu = 27.0)
      }
    }
    BIND("empty-envelope-deficit-27MW" AS ?check)
    BIND(1 AS ?expected)
    FILTER(?actual != ?expected)
  }
  UNION
  {
    # conflict-hygiene-strict.rq must find its four planted defect instances.
    {
      SELECT (COUNT(*) AS ?actual)
      WHERE {
        {
          SELECT DISTINCT ?conflict ?defect
          WHERE {
            { ?conflict a au:Conflict .
              FILTER NOT EXISTS { ?conflict au:witness ?w }
              BIND("UNWITNESSED" AS ?defect) }
            UNION
            { ?conflict a au:Conflict ; au:party ?pa , ?pb .
              ?pa au:discipline ?da . ?pb au:discipline ?db .
              FILTER(STR(?da) < STR(?db))
              FILTER NOT EXISTS { ?conflict au:owner ?o }
              BIND("UNOWNED" AS ?defect) }
            UNION
            { ?conflict a au:Conflict ; au:resolvedBy ?r .
              ?r au:outcome au:Exempt ; au:expires ?e .
              FILTER(?e < xsd:date(NOW()))
              BIND("EXPIRED-WAIVER" AS ?defect) }
            UNION
            { ?conflict a au:Conflict ; au:resolvedBy ?r .
              ?r au:outcome au:Exempt .
              FILTER NOT EXISTS { ?r au:expires ?e }
              BIND("UNBOUNDED-WAIVER" AS ?defect) }
          }
        }
      }
    }
    BIND("conflict-hygiene-strict" AS ?check)
    BIND(4 AS ?expected)
    FILTER(?actual != ?expected)
  }
  UNION
  {
    # ladder-integrity.rq must find its four planted defect instances.
    {
      SELECT (COUNT(*) AS ?actual)
      WHERE {
        {
          SELECT DISTINCT ?claim ?defect
          WHERE {
            { ?claim a rfc:NormativeStatement ; au:rung ?rung .
              FILTER(?rung != au:R0)
              FILTER NOT EXISTS { ?claim au:promotedBy ?p }
              BIND("UNPROVENANCED-RUNG" AS ?defect) }
            UNION
            { ?claim a rfc:NormativeStatement ; au:rung ?rung .
              FILTER(?rung IN (au:R0, au:R1, au:R2, au:R3))
              FILTER NOT EXISTS { ?claim au:stalledOn ?s }
              FILTER NOT EXISTS { ?claim au:demotedBy ?d }
              BIND("UNNAMED-STALL" AS ?defect) }
            UNION
            { ?claim a rfc:NormativeStatement ; au:rung ?rung ; rfc:provenBy ?thm .
              FILTER(?rung IN (au:R0, au:R1, au:R2, au:R3))
              BIND("PROVEN-BELOW-RUNG" AS ?defect) }
          }
        }
      }
    }
    BIND("ladder-integrity" AS ?check)
    BIND(4 AS ?expected)
    FILTER(?actual != ?expected)
  }
  UNION
  {
    # vacuous-invariant.rq must find all THREE planted shapes: a pass over an
    # empty population, an au:Examined over an empty population, and an outcome
    # with no population at all. Three, not one — a gate that only catches the
    # zero and not the absence leaves the more audit-resistant of the two in
    # place, and a gate that lists fewer positive outcomes than the door does is
    # weaker than the thing it exists to confirm.
    {
      SELECT (COUNT(*) AS ?actual)
      WHERE {
        {
          SELECT DISTINCT ?c ?e
          WHERE {
            { ?c a rfc:NormativeStatement ; au:evaluatedBy ?e .
              ?e au:population ?n ; au:outcomeOf ?o .
              FILTER(?n = 0)
              FILTER(?o IN (au:Passes, au:Fails, au:Examined)) }
            UNION
            { ?c a rfc:NormativeStatement ; au:evaluatedBy ?e .
              ?e au:outcomeOf ?o2 .
              FILTER NOT EXISTS { ?e au:population ?any } }
          }
        }
      }
    }
    BIND("vacuous-invariant" AS ?check)
    BIND(3 AS ?expected)
    FILTER(?actual != ?expected)
  }
  UNION
  {
    # envelope-unrecorded.rq must stay SILENT here: this fixture's infeasibility
    # is recorded by fx:conflict-envelope, and the gate keys on whether one was
    # documented rather than on whether one exists. The counterpart assertion —
    # that it FIRES on an undocumented one — is fixtures/expect-undocumented.rq
    # over fixtures/envelope-undocumented.ttl, because no fixture in this
    # directory could ever have made it fire.
    #
    # This branch resolves the open note in BUILD.bazel: the property needed a
    # query label from another package, and inlining the body the way every
    # other assertion here does needs no label at all.
    {
      SELECT (COUNT(*) AS ?actual)
      WHERE {
        {
          SELECT ?q (MAX(?v) AS ?gl)
          WHERE {
            ?c a rfc:NormativeStatement ; au:constrains ?q ; au:hasBound ?b .
            ?b au:boundKind au:LowerBound ; au:boundValue ?v .
          }
          GROUP BY ?q
        }
        {
          SELECT ?q (MIN(?v) AS ?lu)
          WHERE {
            ?c a rfc:NormativeStatement ; au:constrains ?q ; au:hasBound ?b .
            ?b au:boundKind au:UpperBound ; au:boundValue ?v .
          }
          GROUP BY ?q
        }
        ?q a au:Quantity .
        FILTER(?gl > ?lu)
        FILTER NOT EXISTS { ?conflict a au:Conflict ; au:onQuantity ?q . }
      }
    }
    BIND("envelope-unrecorded-silent-when-documented" AS ?check)
    BIND(0 AS ?expected)
    FILTER(?actual != ?expected)
  }
  UNION
  {
    # homonym-unregistered.rq must find the one planted unregistered pair.
    {
      SELECT (COUNT(*) AS ?actual)
      WHERE {
        ?qA a au:Quantity ; au:unit ?u ; au:estimator ?eA .
        ?qB a au:Quantity ; au:unit ?u ; au:estimator ?eB .
        FILTER(STR(?qA) < STR(?qB))
        FILTER(?eA != ?eB)
        FILTER NOT EXISTS { ?qA au:disjointQuantity ?qB }
        FILTER NOT EXISTS { ?qB au:disjointQuantity ?qA }
      }
    }
    BIND("homonym-unregistered" AS ?check)
    BIND(1 AS ?expected)
    FILTER(?actual != ?expected)
  }
  UNION
  {
    # tier-rung-coherence.rq must find exactly the one planted Derivational
    # claim below R4 — and not the Structural-at-R2 claim, which is legal.
    {
      SELECT (COUNT(*) AS ?actual)
      WHERE {
        ?claim a rfc:NormativeStatement ; rfc:tier rfc:Derivational ; au:rung ?rung .
        FILTER(?rung IN (au:R0, au:R1, au:R2, au:R3))
      }
    }
    BIND("tier-rung-coherence" AS ?check)
    BIND(1 AS ?expected)
    FILTER(?actual != ?expected)
  }
}
ORDER BY ?check
