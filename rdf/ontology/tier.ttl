# tier.ttl — GENERATED by //lean:tier_ttl_generated from Spec.Corpus.Schema.Tier.
# Do not hand-edit: change lean/Spec/Emit/TierVocab.lean (or the Tier inductive)
# and run `bazel run //lean:update_tier_ttl`. //lean:tier_ttl_diff_test pins this
# file to the emitter byte for byte.
#
# rfc:tier grades how a NormativeStatement's PROOF is discharged. It is
# orthogonal to au:rung (how far the claim has been formalized): a claim can be
# R4 and still Structural; it cannot be Derivational below R4.
#
# ⛔ ABSENT MEANS UNTIERED, not Structural. The Lean default is a compile-time
# convenience for records that exist in the schema; an unasserted TTL tier is
# not a claim about the proof.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <https://aion.savvi.io/ontology/rfc#> .

:Tier
    a owl:Class ;
    rdfs:label "Proof-discharge tier" ;
    rdfs:comment "How a NormativeStatement's PROOF is discharged. Orthogonal to au:rung, which grades how far the claim has been formalized: a claim can be fully formalized (R4) and still Structural; it cannot be Derivational below R4 — rdf/lint/authoring/tier-rung-coherence.rq enforces exactly that. Emitted from Spec.Corpus.Schema.Tier by //lean:tier_ttl_generated." .

:Structural
    a :Tier ;
    rdfs:label "Structural" ;
    rdfs:comment "Definitionally true from the model's construction; the Lean theorem exists but its proof is trivial (rfl, intro h; exact h). The conservative floor, and the Lean default for a record that exists in the schema." .

:Derivational
    a :Tier ;
    rdfs:label "Derivational" ;
    rdfs:comment "Proven by a non-trivial Lean theorem chain from prior axioms, definitions, or earlier theorems. Presupposes R4: a claim must be typed into the Lean corpus schema before a derivational grade means anything, and rdf/lint/authoring/tier-rung-coherence.rq refuses it below R4." .

:Implemented
    a :Tier ;
    rdfs:label "Implemented" ;
    rdfs:comment "Realized by code that runs in production, with the runtime behavior cross-checked against the spec." .

:tier
    a owl:ObjectProperty ;
    rdfs:domain :NormativeStatement ;
    rdfs:range :Tier ;
    rdfs:label "Tier" ;
    rdfs:comment "Optional. ABSENT MEANS UNTIERED, not Structural: the Lean default is a compile-time convenience for records that exist in the schema, and an unasserted TTL tier is not a claim about the proof. At most one per claim (rdf/ontology/shapes.ttl)." .
