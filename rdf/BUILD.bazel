load("@rules_rdf//rdf:dataset.bzl", "rdf_dataset")
load(":gates.bzl", "spec_corpus_gates")

package(default_visibility = ["//visibility:public"])

# The gate/measure split, as a source file, so
# //rdf/lint/authoring:population_coverage_test can READ `_GATES` rather than
# restate it. A test that carries its own copy of the list cannot notice a gate
# being added without one.
exports_files(["authoring_gates.bzl"])

# The RFC vocabulary as a dataset. Consumers fold this into their corpus
# via `deps = ["@spec//rdf:vocab"]` so the gate queries resolve the
# rfc: terms. tier.ttl rides along because shapes.ttl says `sh:class :Tier`,
# and sh:class is answered from the data graph.
rdf_dataset(
    name = "vocab",
    srcs = [
        "//rdf/ontology:aion-rfc.ttl",
        "//rdf/ontology:tier.ttl",
    ],
    in_format = "turtle",
)

# Self-test: the vocab graph alone conforms (no instances → SHACL passes
# vacuously, zero-row queries return nothing). Proves the shapes + queries
# parse/execute and the macro wires up against the registered Jena toolchain.
spec_corpus_gates(
    name = "vocab_selftest",
    dataset = ":vocab",
)

# The RFC vocabulary PLUS the authoring/coherence profile (RFC-002 §6):
# proposals, the formalization ladder, witnessed conflict, and the quantity /
# scope typing that makes cross-domain incoherence machine-detectable.
#
# Deliberately a SEPARATE target from :vocab rather than an addition to it —
# `authoring.ttl` is additive, but folding it into :vocab would enlarge the graph
# for every existing consumer (Aion, mycelium) whose corpora do not use it.
# Consumers that want it depend on this instead:
#
#   rdf_dataset(name = "corpus", srcs = [...], deps = ["@spec//rdf:authoring_vocab"])
#
# NOTE the shape: both TTLs are listed directly in `srcs`, exactly mirroring
# :vocab above, rather than srcs=[authoring.ttl] + deps=[":vocab"]. Layering one
# rdf_dataset on another via `deps` is untested in this repo — the only precedent
# (//corpus:ratio_corpus) uses a vocab dataset as a dep of a LEAF corpus dataset,
# never of another vocab dataset. This construction is provably identical to
# :vocab, which is known to build. It costs one duplicated src label.
rdf_dataset(
    name = "authoring_vocab",
    srcs = [
        "//rdf/ontology:aion-rfc.ttl",
        "//rdf/ontology:authoring.ttl",
        "//rdf/ontology:tier.ttl",
    ],
    in_format = "turtle",
)

# Self-test for the authoring profile: it parses, conforms vacuously, and the
# consistency gates execute against it. Same rationale as :vocab_selftest.
spec_corpus_gates(
    name = "authoring_vocab_selftest",
    dataset = ":authoring_vocab",
)

# ── Migrated from Aion kg/: the generic RFC/spec-KG query + lint + rule
# catalog. Consumers fold these in alongside their corpus (the SPARQL
# patterns target the rfc: vocab; lints are Tier-3 integrity checks; the
# rule derives rfc:emits from diagnostic-code mentions in rule text).

# Full analytics + consistency query catalog (claims / domain / governance /
# stats / structure / analysis + the 5 consistency gates).
filegroup(
    name = "queries",
    srcs = glob(["queries/**/*.rq"], exclude = ["queries/consistency/*.rq"]) + [
        "//rdf/queries/consistency:circular-deps.rq",
        "//rdf/queries/consistency:dangling-references.rq",
        "//rdf/queries/consistency:diagnostic-collisions.rq",
        "//rdf/queries/consistency:inverse-edges.rq",
        "//rdf/queries/consistency:untyped-documents.rq",
    ],
)

# Semantic lint checks (one .rq each), run by @spec//java:kg_lint_lib.
#
# The authoring family is EXCLUDED. Those queries target the au: vocabulary,
# which a plain rfc: corpus does not carry — folding them in here would have
# KgLint run them over graphs where every pattern is unmatched. They are wired as
# their own gate suite instead (//rdf:authoring_gates.bzl), and exposed as a set
# by //rdf/lint/authoring:queries.
filegroup(
    name = "lint",
    srcs = glob(
        ["lint/**/*.rq"],
        exclude = ["lint/authoring/**/*.rq"],
    ),
)

# NOTE: there is deliberately no :authoring_lint filegroup here. The authoring
# queries are consumed via //rdf:authoring_gates.bzl, which Label()-references
# them individually, and via //rdf/lint/authoring:queries for anyone who wants
# the set. A filegroup in THIS package would have to reach across the
# rdf/lint/authoring package boundary for no consumer that exists today.

# Jena inference rules (e.g. emits-from-text), run by @spec//java:reasoner.
filegroup(
    name = "rules",
    srcs = glob(["rules/*.rule"]),
)
