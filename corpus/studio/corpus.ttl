    rfc:modality rfc:MUST ;
    rfc:predicate "Sponsor attribute edits require effective `sponsor:edit` (AUTH-14). Sponsor **deletion** is reserved to users of the platform-owning organization and SAVVI staff, and removes downstream data. There is no sponsor archive state — retirement is modeled by archiving plan years (story 33). A stamped reseller's lifecycle authority (AUTH-51) covers archival/offboarding workflows, not deletion." ;
    rdfs:label "AUTH-57" ;
    au:discipline st:platforms ;
    au:rung au:R0 ;
    au:stalledOn "modality-unstated: the text states no modal verb, so rfc:MUST is a placeholder awaiting a person" .

