st:auth-53 a rfc:NormativeStatement ;
    rfc:modality rfc:MUST ;
    rfc:predicate "An **org admin** holds AuthKit `admin` on their active membership (JWT claim, §4.11). That claim gates team creation (AUTH-52), team management (AUTH-9), visibility (§4.5.1), grant management (AUTH-30), and private-sponsor visibility (AUTH-12). Shorthand roles (§2.3) are org admins of those organization kinds. Because the claim lives in the session JWT, org-role changes take effect when the token refreshes (login, org switch, session refresh) — not necessarily on the next request, unlike database-backed authorization (§4.11)." ;
    rdfs:label "AUTH-53" ;
    au:discipline st:identity ;
    au:rung au:R0 ;
    au:stalledOn "modality-unstated: the text states no modal verb, so rfc:MUST is a placeholder awaiting a person" .

