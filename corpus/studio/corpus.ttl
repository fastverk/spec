    rfc:predicate "Direct user lookup succeeds for SAVVI staff, for active members of a collaborating org, and for users referenced on an entity the viewer can already see (plan-year contact/implementor/broker, task assignee/delegate); otherwise not-found (AUTH-17)." ;
    rdfs:label "AUTH-64" ;
    au:discipline st:directory ;
    au:rung au:R0 ;
    au:stalledOn "modality-unstated: the text states no modal verb, so rfc:MUST is a placeholder awaiting a person" .

st:auth-65 a rfc:NormativeStatement ;
