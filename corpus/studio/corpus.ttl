    rfc:modality rfc:MUST ;
    rfc:predicate "**Task templates** are platform-scoped, optionally audienced to a reseller. Managing them (create/edit/delete) requires SAVVI staff or an org admin of the platform-owning organization. Instantiating a template follows normal task-creation rules (effective `sponsor:edit` on the target sponsor), and the template's platform/reseller audience must match the sponsor." ;
    rdfs:label "AUTH-58" ;
    au:discipline st:platforms ;
    au:rung au:R0 ;
