    rfc:modality rfc:MUST_NOT ;
    rfc:predicate "Each WorkOS Organization controls its own authentication policy. Access shared across organizations (§4.6) never subjects a user to another organization's identity provider." ;
    rdfs:label "AUTH-2b" ;
    au:discipline st:identity ;
    au:rung au:R0 ;
