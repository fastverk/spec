st:auth-30 a rfc:NormativeStatement ;
    rfc:modality rfc:MAY ;
    rfc:predicate "Who may grant a sponsor to another WorkOS Organization: platform users with `sponsor:edit`, org admins, SAVVI staff (AUTH-20), and **reseller admins** for stamped sponsors (AUTH-51, no escalation). Each grant carries an explicit permission set from §2.4; orthogonal permissions (`sponsor:analytics`, `deploy:*`) only when listed. At most one grant exists per (sponsor, recipient org); granting again updates that grant's permission set (AUTH-32)." ;
    rdfs:label "AUTH-30" ;
    au:discipline st:grants ;
    au:rung au:R0 ;
    au:stalledOn "not-decomposed: modality was pattern-matched from the claim text and nobody has confirmed it; no terms grounded, so nothing can be checked yet" .

st:auth-31 a rfc:NormativeStatement ;
    rfc:modality rfc:MUST ;
    rfc:predicate "In the recipient org, team roles and visibility baselines apply **intersected** with the grant (check-time, §4.11). An orthogonal permission carried by a grant is therefore effective only where the derived side also confers it: `sponsor:analytics` via a team role or a public baseline listing it (AUTH-41), `deploy:*` via team roles only (AUTH-26). Example — grant `{sponsor:view}`: | Broker team role | Role would confer | Effective on Acme | | ---------------- | ----------------------------------------------------------- | --------------------------------------------------------------- | | `implementor` | `sponsor:edit`, `sponsor:analytics`, `deploy:nonproduction` | `sponsor:view` (limited by grant; analytics/deploy not granted) | | `reporter` | `sponsor:report` | `sponsor:report` |" ;
    rdfs:label "AUTH-31" ;
    au:discipline st:grants ;
    au:rung au:R0 ;
    au:stalledOn "modality-unstated: the text states no modal verb, so rfc:MUST is a placeholder awaiting a person" .

st:auth-32 a rfc:NormativeStatement ;
    rfc:modality rfc:MUST ;
    rfc:predicate "Grants and their permission sets are editable/revocable by the same parties as AUTH-30. Revocation takes effect on the next check; recipient team assignments become inert (AUTH-17)." ;
    rdfs:label "AUTH-32" ;
    au:discipline st:grants ;
    au:rung au:R0 ;
    au:stalledOn "modality-unstated: the text states no modal verb, so rfc:MUST is a placeholder awaiting a person" .

st:auth-33 a rfc:NormativeStatement ;
    rfc:modality rfc:MUST ;
    rfc:predicate "Grants are non-transferable except stamped reseller orgs (AUTH-50/51), which extend grants to collaborating orgs (brokers, the sponsor's own org) **on behalf of the platform**, capped **at issue time** to the reseller's own granted set (no escalation, including edits to its own grant). Once issued, such grants are ordinary platform grants — AUTH-30/32 parties edit or revoke them; creator provenance is `sponsor_grants.created_by_id`. Narrowing the reseller's own grant later does not retroactively narrow grants it already issued." ;
    rdfs:label "AUTH-33" ;
    au:discipline st:grants ;
    au:rung au:R0 ;
    au:stalledOn "modality-unstated: the text states no modal verb, so rfc:MUST is a placeholder awaiting a person" .

