st:auth-1 a rfc:NormativeStatement ;
    rfc:modality rfc:MAY ;
    rfc:predicate "Every organization kind (§2.1) may authenticate through SSO, email domain, or email invite. Each platform-owning org, reseller, broker, sponsor organization, and SAVVI is a distinct **WorkOS Organization**. WorkOS Organizations provide authentication (org-scoped sessions), SSO and other auth methods (domains, invitations, MFA where required — AUTH-54), and memberships with org-level roles such as `admin` (AUTH-53). Studio authorization is layered in the application database (§4.11); it is not WorkOS FGA. On the SAVVI organization, org `admin` also covers AUTH-27." ;
    rdfs:label "AUTH-1" ;
    au:discipline st:identity ;
    au:rung au:R0 ;
    au:stalledOn "not-decomposed: modality was pattern-matched from the claim text and nobody has confirmed it; no terms grounded, so nothing can be checked yet" .

st:auth-2 a rfc:NormativeStatement ;
    rfc:modality rfc:MAY ;
    rfc:predicate "A user is a single identity (one account, one email) that may hold memberships in **any number of WorkOS Organizations**, each with its own org-level role. Multi-org membership is the exception, not the collaboration mechanism — cross-org access flows through grants (§4.6)." ;
    rdfs:label "AUTH-2" ;
    au:discipline st:identity ;
    au:rung au:R0 ;
    au:stalledOn "not-decomposed: modality was pattern-matched from the claim text and nobody has confirmed it; no terms grounded, so nothing can be checked yet" .

st:auth-2a a rfc:NormativeStatement ;
    rfc:modality rfc:MUST ;
    rfc:predicate "A user always acts in exactly **one active WorkOS Organization**. Authorization is evaluated for (user, active org); switching org re-derives roles, permissions, and visibility." ;
    rdfs:label "AUTH-2a" ;
    au:discipline st:identity ;
    au:rung au:R0 ;
    au:stalledOn "modality-unstated: the text states no modal verb, so rfc:MUST is a placeholder awaiting a person" .

