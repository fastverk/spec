    rfc:modality rfc:MAY ;
    rfc:predicate "Reseller-created sponsors: stamp `reseller_organization_id` (AUTH-50/51), assign to the book team, and §4.6-grant to the reseller org (enters as `public`, AUTH-39). Immediate — no platform-owner approval. Platform admins may also create a sponsor and assign it to a reseller." ;
    rdfs:label "AUTH-44" ;
    au:discipline st:resellers ;
    au:rung au:R0 ;
    au:stalledOn "not-decomposed: modality was pattern-matched from the claim text and nobody has confirmed it; no terms grounded, so nothing can be checked yet" .

