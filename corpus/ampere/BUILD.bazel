load("@rules_rdf//rdf:dataset.bzl", "rdf_dataset")
load("@rules_rdf//sparql:defs.bzl", "sparql_query")
load("//rdf:authoring_gates.bzl", "spec_authoring_gates")
load("//rdf:gates.bzl", "spec_corpus_gates")

package(default_visibility = ["//visibility:public"])

# AMPERE — the RFC-002 §11 worked corpus. A 400 MWh / 100 MW grid-scale battery
# plus an aggregated DER virtual power plant in two wholesale markets, across 12
# disciplines: 14 documents, 15 sections, 64 normative statements, 20 typed
# quantities, 12 scopes, 12 recorded conflicts (5 adjudicated).
#
#   bazel test  //corpus/ampere/...            # structural + authoring gates
#   bazel build //corpus/ampere:measure        # the corpus counts
#   bazel build //corpus/ampere:ampere_authoring_empty_envelope
#   cat bazel-bin/corpus/ampere/ampere_authoring_empty_envelope.tsv
#
# CITATION POSTURE: every clause number, edition and value in this corpus is a
# LEAD, not a fact — nothing was citation-verified, and no real market operator,
# manufacturer, insurer or jurisdiction is named. See README.md. The corpus
# exists to exercise mechanisms.

# ── The full corpus ─────────────────────────────────────────────────────────
# Note the dep is //rdf:authoring_vocab (rfc: + au:), not //rdf:vocab — the
# authoring gates key on au: terms and would pass vacuously without them.
# ⛔ ONE LIST, TWO READERS. The gates load this dataset; `//tools/readmodel:
# corpus_is_the_corpus_test` compares it against `glob(["*.ttl"])` — everything
# actually on disk — and fails if they differ. That comparison is the whole gate:
# `tools/readmodel/emit_readmodel.py` decides what the corpus IS by listing the
# directory, so a `.ttl` here that the dataset does not name is a file the console
# serves and no gate ever ran over.
AMPERE_CORPUS = [
    "conflicts.ttl",
    "corpus.ttl",
    "disciplines.ttl",
]

rdf_dataset(
    name = "ampere",
    srcs = AMPERE_CORPUS,
    in_format = "turtle",
    deps = ["//rdf:authoring_vocab"],
)

# What the gates say the corpus is…
filegroup(
    name = "corpus_ttl",
    srcs = AMPERE_CORPUS,
)

# …and what is actually in the directory. A glob, deliberately: the strays this
# catches are by definition files nobody listed.
filegroup(
    name = "all_ttl",
    srcs = glob(["*.ttl"]),
)

# The pre-existing structural suite: SHACL conformance plus the five consistency
# invariants. THE POINT OF RUNNING IT HERE is that it passes — the corpus is
# clean under every check the spine had before RFC-002, and still contains two
# empty feasible envelopes. modality-conflict.rq cannot see them because it
# matches on byte-equal predicate text, and the colliding claims share no words,
# no document, no discipline and no citation.
spec_corpus_gates(
    name = "ampere_gates",
    dataset = ":ampere",
)

# The RFC-002 authoring suite: 5 zero-row gates + 4 reported measures.
#
# All five gates pass over the full corpus. That is not because the corpus is
# free of conflict — it has 12, seven of them open — but because every conflict
# is recorded, witnessed and owned. Which is exactly the property being gated.
spec_authoring_gates(
    name = "ampere_authoring",
    dataset = ":ampere",
)

# ── The demonstration that envelope_unrecorded has teeth ────────────────────
#
# Deliberately NOT a target. The obvious construction — the same corpus without
# conflicts.ttl, whose envelope_unrecorded gate then fires with 2 rows — would be
# a permanently RED target, and in a repo whose culture is "green gates or it
# isn't real" a target that always fails is an invitation to start ignoring CI.
#
# Express it as a POSITIVE assertion instead, in the style of
# //rdf/lint/authoring/fixtures:expect_detections: a query over the
# conflicts-stripped dataset whose expected row count is 2, which is zero-row
# (green) exactly when the gate is working. Verified by hand meanwhile:
#
#   corpus minus conflicts.ttl -> envelope-unrecorded.rq = 2 rows
#     q-sustained-discharge  MW  82.0 > 55.0  deficit 27.0
#     q-telemetry-latency    ms 180.0 > 150.0 deficit 30.0
#
# ── Measures ────────────────────────────────────────────────────────────────

# Corpus counts: documents, sections, claims, disciplines, quantities, bounds,
# scopes, and the rung histogram that yields the dark fraction.
sparql_query(
    name = "measure",
    dataset = ":ampere",
    query = "queries/ampere-measure.rq",
    out_format = "tsv",
)

# Per-discipline coverage: claim count, how many carry a typed quantity, how
# many are non-defeasible, and the sub-R4 (dark) count.
sparql_query(
    name = "coverage",
    dataset = ":ampere",
    query = "queries/discipline-coverage.rq",
    out_format = "tsv",
)

# The frontier: sub-R4 claims with the blocker each one names.
sparql_query(
    name = "frontier",
    dataset = ":ampere",
    query = "queries/frontier.rq",
    out_format = "tsv",
)

# ⛔ `*.ttl` HERE IS THE CORPUS, AND NOTHING ELSE IS.
#
# The two derivation-test overlays used to sit beside these files as
# `fixtures-*.ttl`, and both say so in their own first line: "an overlay for the
# derivation test, NOT part of the committed corpus." They were in the corpus
# directory anyway, so every tool that asks the FILESYSTEM what the corpus is got
# the wrong answer — and one does. `tools/readmodel/emit_readmodel.py` lists
# `*.ttl` and loads what it finds.
#
# ⚠ THE TENSE MATTERS. Nothing shipped wrong: the committed payloads predate
# these fixtures, so the console has never served them. What was armed is the
# NEXT regeneration — a routine step after any TTL change — and it would have
# been silent. Measured by running it:
#
#     INV-03   committed: state open,     outcome ""
#              re-emitted: state RESOLVED, outcome "Narrow"
#
# plus a 65th claim (`mkt-quiet-hours`) carrying no `au:rung` — the exact defect
# `ladder-integrity.rq` exists to catch — as an ordinary requirement, and its
# witness row on INV-05. Nine rows across five of the eight payloads.
#
# The fixtures now live in `fixtures/`, and
# `//tools/readmodel:corpus_is_the_corpus_test` fails if a `.ttl` ever appears
# here that the gate dataset does not list.
exports_files(glob(["*.ttl"]) + glob(["fixtures/*.ttl"]))

# ── Fanout: the work orders the conflicts have been naming all along ─────────
#
# Four orders, ids from the strings ampere's conflicts already carry in
# au:blocksWorkOrder — mock-only until spec#45. Derivation is honest about
# closure touch: with seven conflicts open, EVERY order starts held somewhere
# (the transcript's READY column described a cleaner world than this corpus).
# The releases are earned by adjudication, which is what the second target
# demonstrates: the same config over the corpus plus INV-03's resolution
# derives wo-042 READY. //tools/fanout:ampere_fanout_test pins both
# directions.
load("//rdf/fanout:fanout.bzl", "spec_workorders")
load("//rdf/readmodel:readmodel.bzl", "spec_readmodel")

spec_workorders(
    name = "workorders",
    config = "fanout.json",
    dataset = ":ampere",
    srcs = AMPERE_CORPUS,
)

rdf_dataset(
    name = "ampere_inv03_resolved",
    srcs = [
        "fixtures/inv03-resolution.ttl",
    ] + AMPERE_CORPUS,
    in_format = "turtle",
    deps = ["//rdf:authoring_vocab"],
)

spec_workorders(
    name = "workorders_inv03_resolved",
    config = "fanout.json",
    dataset = ":ampere_inv03_resolved",
    srcs = ["fixtures/inv03-resolution.ttl"] + AMPERE_CORPUS,
)

# ── The fail-open control (see fixtures/unrunged-party.ttl) ────────────────
rdf_dataset(
    name = "ampere_unrunged",
    srcs = [
        "fixtures/unrunged-party.ttl",
    ] + AMPERE_CORPUS,
    in_format = "turtle",
    deps = ["//rdf:authoring_vocab"],
)

spec_workorders(
    name = "workorders_unrunged",
    config = "fanout.json",
    dataset = ":ampere_unrunged",
    srcs = ["fixtures/unrunged-party.ttl"] + AMPERE_CORPUS,
)

# ⛔ The read model, under the ENGINE OF RECORD — the ARQ/rdflib comparison #52
# asks for, as a target rather than as a claim. `tools/readmodel/emit_readmodel.py`
# answers these same eight questions under rdflib and its output is what is
# committed under services/spec/readmodel/; this derives them under ARQ, and
# //tools/readmodel:engine_agreement_test compares the two row for row.
spec_readmodel(
    name = "readmodel",
    dataset = ":ampere",
    project = "ampere",
    srcs = AMPERE_CORPUS,
)
