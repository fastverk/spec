# Bazel module registries: fastverk public + premium, then BCR. rules_lean
# (the Lean toolchain backing the spec-framework modules) resolves from the
# public fastverk registry. Made explicit here so the build is self-contained
# (previously relied on a global/user.bazelrc).
common --registry=https://raw.githubusercontent.com/fastverk/bazel-registry/main/
common --registry=https://bcr.bazel.build/

# The services/spec plugin's crate_universe `crate` extension uses isolate = True;
# isolated usages are flag-gated in Bazel 9.x — enable so CI matches local.
common --experimental_isolated_extension_usages

# Apache Jena 5.x is compiled for Java 17+. Pin a remote 21 JDK for both
# target and tool builds (same pin as the Aion + mycelium repos).
build --java_runtime_version=remotejdk_21
build --tool_java_runtime_version=remotejdk_21
build --java_language_version=21
build --tool_java_language_version=21

# rules_jvm_external invokes coursier (a Java tool) at maven-fetch time,
# and coursier needs a JDK on PATH / JAVA_HOME. Inherit JAVA_HOME from the
# environment so the fetch works locally and in CI.
common --repo_env=JAVA_HOME
build --action_env=JAVA_HOME

try-import %workspace%/user.bazelrc

# protobuf's upb uses the linkarr encapsulation-symbol pattern; lld's default
# --gc-sections drops the section and leaves __start_/__stop_linkarr_upb_AllExts
# undefined when linking protoc-gen-upb_stage0 under zig. Required whenever zig is
# registered globally (see MODULE.bazel).
common --enable_platform_specific_config
build:linux --host_linkopt=-Wl,--no-gc-sections
build:linux --linkopt=-Wl,--no-gc-sections
