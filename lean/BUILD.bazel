load("@rules_lean//lean:lean.bzl", "lean_test")

package(default_visibility = ["//visibility:public"])

# Generic spec-framework Lean modules. Exposed as source labels so cross-repo
# consumers (Aion's lean_test targets) list them in their own `srcs` —
# rules_lean shares Lean source at the file level, not via a LeanInfo provider
# (same pattern as @rules_postgres//lean). The namespace is neutral `Spec.*`
# (Spec.{Universe,Predicates,Kernel,Axioms}, Spec.Emit.{TtlEmit,MdEmit},
# Spec.Corpus.Schema) so any consumer can ground its own corpus on the kernel
# without inheriting an `Aion`-specific name.
exports_files([
    "Spec/Universe.lean",
    "Spec/Predicates.lean",
    "Spec/Kernel.lean",
    "Spec/Axioms.lean",
    "Spec/Corpus/Schema.lean",
    "Spec/Corpus/Inference.lean",
    "Spec/Emit/TtlEmit.lean",
    "Spec/Emit/MdEmit.lean",
    "Spec/Logic/Core.lean",
    "Spec/Logic/InferenceRulesProofs.lean",
    "Spec/Compaction/Projection.lean",
    "Spec/Grounding/WriteDoor.lean",
])

# The deterministic corrector core: proves the compaction (reverse-diffusion
# corrector) invariants — meaning-preserving, energy-non-increasing, idempotent —
# for the redundancy-collapse pass. Pure Lean 4 core; compiling = proofs check.
lean_test(
    name = "compaction_test",
    srcs = ["Spec/Compaction/Projection.lean"],
    entry = "Spec/Compaction/Projection.lean",
)

# The machine-checked grounding for the ratio corpus's write-door / conservation
# claims — the proof object //corpus claims point at via :provenBy. Compiling
# (sorry-free) IS the verification that the grounding is real; the
# //corpus:grounding_verified gate ties the corpus's :provenBy to it.
lean_test(
    name = "grounding_test",
    srcs = ["Spec/Grounding/WriteDoor.lean"],
    entry = "Spec/Grounding/WriteDoor.lean",
)

# Compile the whole framework here (no external deps — pure Lean 4 core).
lean_test(
    name = "spec_framework_test",
    srcs = [
        "Spec/Universe.lean",
        "Spec/Predicates.lean",
        "Spec/Kernel.lean",
        "Spec/Axioms.lean",
        "Spec/Corpus/Schema.lean",
        "Spec/Corpus/Inference.lean",
        "Spec/Emit/TtlEmit.lean",
        "Spec/Emit/MdEmit.lean",
        "Spec/Logic/Core.lean",
        "Spec/Logic/InferenceRulesProofs.lean",
        "Spec/FrameworkCheck.lean",
    ],
    entry = "Spec/FrameworkCheck.lean",
)
