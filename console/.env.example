# Copy to .env.local for local development. NEVER commit a filled-in copy.

# ── identity ─────────────────────────────────────────────────────────────────
# From Google Cloud → APIs & Services → Credentials → OAuth client ID (Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" on that client, exactly.
GOOGLE_REDIRECT_URI=https://<your-host>/api/auth/callback
# ⛔ Fails closed. Unset means nobody can sign in, never everybody.
GOOGLE_ALLOWED_DOMAIN=savvifi.com
# openssl rand -hex 32 — no default, because a known secret forges authors.
SESSION_SECRET=

# ── the log ──────────────────────────────────────────────────────────────────
# The APP credential: INSERT and SELECT only. Never the owner — the owner can
# DISABLE TRIGGER and delete an append-only log.
DATABASE_URL=

# ── grounding ────────────────────────────────────────────────────────────────
# The project's adapter. Unset ⇒ the Grounding pane says no adapter is answering,
# which is a missing answer and not an empty one.
GROUNDING_ADAPTER_URL=

# ── capability ───────────────────────────────────────────────────────────────
# CSV of subs (google:<id>) holding kernel capability. Empty means nobody.
SPEC_KERNEL_SUBS=

# ── local development only ───────────────────────────────────────────────────
# Used ONLY when no GOOGLE_CLIENT_ID is set and NODE_ENV is not production.
# SPEC_AUTHOR=you@savvifi.com
# SPEC_PROPOSAL_LOG=/tmp/spec-proposals.jsonl
